---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mur from '../components/Mur.astro';
const items = (await getCollection('oeuvres')).filter((o) => o.data.type === 'sculpture');
---
<Base title="Sculptures" description="Personnages sculptés à la main : l’autre versant du travail d’Adelem.">
  <section class="wrap haut-page pile">
    <h1 class="titre-section">Sculptures</h1>
    <p class="texte">Le même regard, une autre matière : des personnages façonnés à la main. Ils naissent plus rarement que les tableaux, un à un.</p>
  </section>
  <section class="wrap bloc">
    {items.length ? <Mur oeuvres={items} eager echelleLocale /> : <p class="discret">Les pièces seront présentées ici au fil de leur création.</p>}
  </section>
</Base>
<style>.haut-page { padding-top: clamp(40px, 6vw, 80px); }</style>
