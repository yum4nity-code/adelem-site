---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Merci" noindex>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Demande envoyée</p>
      <h1>Merci</h1>
      <p class="lead" style="margin-top:1rem">Votre message est bien arrivé. Adelem vous répond sous {site.delaiReponse}.</p>
      <div class="actions"><a class="btn ghost" href="/galerie">Poursuivre la visite</a></div>
    </div>
  </section>
</Base>
