---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Merci" noindex>
  <section class="wrap haut-page pile">
    <h1 class="titre-section">Merci</h1>
    <p class="texte">Votre message est bien arrivé. Adèle vous répond sous {site.delaiReponse}.</p>
    <a class="lien" href="/galerie">Revenir aux œuvres</a>
  </section>
</Base>
<style>.haut-page { padding-top: clamp(60px, 8vw, 120px); }</style>
