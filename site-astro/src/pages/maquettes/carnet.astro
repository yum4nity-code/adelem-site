---
// Maquettes du carnet d'atelier (2026-11-01) pour qu'Adèle choisisse sur pièce. Page cachée (noindex, hors sitemap).
// A : grille de 3 vignettes + pensée en plein écran au clic. B : petits cartons crème « Nouvelles de l'atelier » + même plein écran.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const entrees = (await getCollection('carnet')).sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const date = (iso?: string | null) => (iso ? new Date(iso + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '');
const data = entrees.map((e) => ({ titre: e.data.titre, texte: e.data.texte, date: date(e.data.date), vignette: e.data.images[0].vignette, grande: e.data.images[0].grande }));
---
<Base title="Maquettes du carnet" noindex>
  <section class="wrap haut">
    <p class="etiquette">Maquettes · à choisir</p>
    <h1 class="titre-section">Deux façons de présenter le carnet</h1>
    <p class="texte">Touchez une pensée pour l’ouvrir en grand, puis les flèches (ou glissez) pour feuilleter.</p>
  </section>

  <section class="wrap bloc-maquette">
    <h2 class="nom">A · La grille, et la pensée en grand au toucher</h2>
    <div class="grilleA">
      {data.map((e, i) => (
        <button type="button" class="carteA" data-ouvrir={i}>
          <img src={e.vignette} alt="" loading="lazy" width="640" height="480" />
          <span class="date">{e.date}</span>
          <span class="titreA">{e.titre}</span>
          <span class="texteA">{e.texte}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="wrap bloc-maquette">
    <h2 class="nom">B · Nouvelles de l’atelier : de petits cartons</h2>
    <div class="grilleB">
      {data.map((e, i) => (
        <button type="button" class="carteB" data-ouvrir={i}>
          <img src={e.vignette} alt="" loading="lazy" width="640" height="480" />
          <span class="date">{e.date}</span>
          <span class="texteB">{e.texte}</span>
          <span class="titreB">{e.titre}</span>
        </button>
      ))}
    </div>
  </section>

  <div class="pensee" hidden data-pensee>
    <div class="pensee-corps">
      <img alt="" data-p-img />
      <div class="pensee-texte">
        <p class="date" data-p-date></p>
        <blockquote data-p-texte></blockquote>
        <p class="pensee-titre" data-p-titre></p>
      </div>
    </div>
    <button type="button" class="pensee-nav prec" aria-label="Pensée précédente" data-prec>‹</button>
    <button type="button" class="pensee-nav suiv" aria-label="Pensée suivante" data-suiv>›</button>
    <button type="button" class="pensee-fermer" aria-label="Fermer" data-fermer>×</button>
    <p class="pensee-compte" data-p-compte></p>
  </div>
</Base>

<script is:inline define:vars={{ data }}>
  const p = document.querySelector('[data-pensee]');
  let i = 0;
  const montrer = () => {
    const e = data[i];
    p.querySelector('[data-p-img]').src = e.grande;
    p.querySelector('[data-p-date]').textContent = e.date;
    p.querySelector('[data-p-texte]').textContent = e.texte;
    p.querySelector('[data-p-titre]').textContent = e.titre;
    p.querySelector('[data-p-compte]').textContent = `${i + 1} / ${data.length}`;
  };
  const ouvrir = (k) => { i = k; montrer(); p.hidden = false; document.documentElement.style.overflow = 'hidden'; };
  const fermer = () => { p.hidden = true; document.documentElement.style.overflow = ''; };
  const aller = (d) => { i = (i + d + data.length) % data.length; montrer(); };
  document.querySelectorAll('[data-ouvrir]').forEach((b) => b.addEventListener('click', () => ouvrir(+b.dataset.ouvrir)));
  p.querySelector('[data-fermer]').onclick = fermer;
  p.querySelector('[data-prec]').onclick = () => aller(-1);
  p.querySelector('[data-suiv]').onclick = () => aller(1);
  addEventListener('keydown', (e) => { if (p.hidden) return; if (e.key === 'Escape') fermer(); if (e.key === 'ArrowLeft') aller(-1); if (e.key === 'ArrowRight') aller(1); });
  let x0 = null;
  p.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  p.addEventListener('touchend', (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) aller(dx < 0 ? 1 : -1); x0 = null; });
</script>

<style>
  .haut { padding-top: clamp(40px, 6vw, 72px); display: flex; flex-direction: column; gap: 14px; }
  .etiquette { font: 500 .7rem var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--or); }
  .bloc-maquette { margin-top: clamp(56px, 8vw, 96px); }
  .nom { font: italic 300 1.6rem var(--serif); color: var(--or); margin-bottom: 28px; padding-bottom: 12px; border-bottom: 1px solid var(--trait); }
  button { all: unset; cursor: zoom-in; box-sizing: border-box; }
  button:focus-visible { outline: 2px solid var(--encre); outline-offset: 4px; }
  .date { display: block; font: 400 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--or); }

  /* A */
  .grilleA { display: grid; gap: clamp(32px, 4vw, 56px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .carteA { display: flex; flex-direction: column; gap: 12px; }
  .carteA img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; box-shadow: 0 24px 40px -20px rgba(0, 0, 0, .65); transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  @media (hover: hover) { .carteA:hover img { transform: translateY(-4px); } }
  .titreA { font: italic 300 1.4rem/1.25 var(--serif); color: var(--encre); }
  .texteA { font-size: .95rem; line-height: 1.7; color: var(--texte); }

  /* B */
  .grilleB { display: grid; gap: clamp(40px, 5vw, 64px) clamp(28px, 4vw, 56px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); padding: 8px; }
  .carteB { background: #ECE6D8; color: #2A2620; padding: 14px 14px 20px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 22px 40px -18px rgba(0, 0, 0, .7); transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  .carteB:nth-child(3n+1) { transform: rotate(-2deg); }
  .carteB:nth-child(3n+2) { transform: rotate(1.5deg) translateY(14px); }
  .carteB:nth-child(3n) { transform: rotate(-1deg); }
  @media (hover: hover) { .carteB:hover { transform: rotate(0) translateY(-4px); } }
  .carteB img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .carteB .date { color: #8a6d3b; font-size: .66rem; }
  .texteB { font: italic 400 1.25rem/1.35 var(--serif); color: #2A2620; }
  .titreB { font: 400 .78rem var(--sans); color: #6b6559; }

  /* Pensée en plein écran */
  .pensee { position: fixed; inset: 0; z-index: 50; background: #141914; display: grid; place-items: center; overflow-y: auto; padding: 64px clamp(20px, 8vw, 120px); }
  .pensee[hidden] { display: none; }
  .pensee-corps { display: grid; gap: clamp(24px, 5vw, 72px); grid-template-columns: 1fr; align-items: center; width: 100%; max-width: 1200px; }
  @media (min-width: 900px) { .pensee-corps { grid-template-columns: 1.1fr 1fr; } }
  .pensee img { width: 100%; max-height: 62vh; object-fit: contain; box-shadow: 0 30px 60px -25px rgba(0, 0, 0, .8); }
  .pensee blockquote { margin: 14px 0 0; font: italic 300 clamp(1.7rem, 3.2vw, 3rem)/1.2 var(--serif); color: var(--encre); }
  .pensee-titre { margin-top: 18px; font: 400 .8rem var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--discret); }
  .pensee-nav { position: absolute; top: 50%; transform: translateY(-50%); font: 300 3rem var(--serif); color: var(--encre); opacity: .7; padding: 12px; cursor: pointer; }
  .pensee-nav:hover { opacity: 1; }
  .prec { left: clamp(4px, 2vw, 32px); } .suiv { right: clamp(4px, 2vw, 32px); }
  .pensee-fermer { position: absolute; top: 18px; right: clamp(12px, 3vw, 40px); font: 300 2.2rem var(--sans); color: var(--encre); cursor: pointer; padding: 6px 10px; }
  .pensee-compte { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); font: 400 .74rem var(--sans); letter-spacing: .2em; color: var(--discret); }
  @media (max-width: 899px) { .pensee img { max-height: 42vh; } .pensee-nav { top: auto; bottom: 8px; transform: none; } }
</style>
