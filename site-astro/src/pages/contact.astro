---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, prix } from '../data/site';
import IconeInstagram from '../components/IconeInstagram.astro';
// Rappel de la pièce quand on arrive depuis une fiche (/contact?piece=Titre) : petite fiche au-dessus du formulaire.
const pieces = Object.fromEntries(
  (await getCollection('oeuvres')).map((o) => [o.data.titre, { img: o.data.photos[0].mini ?? o.data.photos[0].src, prix: o.data.statut === 'disponible' && o.data.prix ? prix(o.data.prix) : '', href: `/oeuvres/${o.id}` }]),
);
const tel = site.contact.telephone;
const whatsapp = tel ? `https://wa.me/${tel.replace(/[^0-9]/g, '')}` : null;
---
<Base title="Contact" description="Écrire à l’atelier Adelem : une question sur une pièce, un cadeau, un mur à habiller. Réponse personnelle sous 3 jours ouvrés.">
  <section class="wrap duo haut-page">
    <div class="pile">
      <h1 class="titre-section">Écrire à l’atelier</h1>
      <p class="texte">Une œuvre qui vous intéresse, un mur à habiller : quelques lignes suffisent. Réponse sous {site.delaiReponse}.</p>
      <ul class="coord">
        {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
        {tel && <li><a class="chiffres" href={`tel:${tel.replace(/\s/g, '')}`}>{tel}</a></li>}
        {site.contact.instagram && <li><a class="insta" href={site.contact.instagram}><IconeInstagram /><span>@{site.contact.instagram.replace(/\/$/, '').split('/').pop()}</span></a></li>}
      </ul>
      {whatsapp && <a class="lien secondaire" href={whatsapp} target="_blank" rel="noopener">Écrire sur WhatsApp</a>}
      <a class="rappel" href="#" hidden data-rappel>
        <img src="" alt="" width="72" height="72" />
        <span><em data-rappel-titre></em><small data-rappel-prix></small><small class="retour-piece">← Revenir à la pièce</small></span>
      </a>
      {/* Carte de correspondance : le mot d'Adèle, signé, avec le badge végétal d'Adelem. */}
      <figure class="carte">
        <img class="badge" src="/logo/adelem-badge-vegetal-photo.png" alt="" width="132" height="132" loading="lazy" />
        <figcaption>
          <p>Je lis et je réponds moi-même à chaque message.</p>
          <img class="signature-carte" src="/logo/adelem-signature.svg" alt="Adelem" width="180" height="74" loading="lazy" />
        </figcaption>
      </figure>
    </div>
    <div class="colonne-form">
      <ContactForm sujets />
    </div>
  </section>
</Base>
<script is:inline define:vars={{ pieces }}>
  const titre = (new URLSearchParams(location.search).get('piece') || '').trim();
  const p = pieces[titre];
  const r = document.querySelector('[data-rappel]');
  if (p && r) {
    r.href = p.href;
    r.querySelector('img').src = p.img;
    r.querySelector('[data-rappel-titre]').textContent = titre;
    r.querySelector('[data-rappel-prix]').textContent = p.prix;
    r.hidden = false;
  }
</script>
<style>
  .haut-page { padding-top: clamp(40px, 6vw, 80px); align-items: start; }
  .coord .insta { display: inline-flex; align-items: center; gap: 10px; }
  .coord { list-style: none; padding: 0; margin: 0; font: 300 1.3rem var(--serif); color: var(--encre); display: grid; gap: 4px; }
  /* Chiffres alignés (la police affiche par défaut des chiffres « à l'ancienne », qui montent et descendent). */
  .chiffres { font-variant-numeric: lining-nums tabular-nums; font-feature-settings: 'lnum' 1, 'tnum' 1; }
  .carte { margin: clamp(16px, 3vw, 40px) 0 0; display: flex; align-items: center; gap: 22px; max-width: 420px; padding: 26px 28px; background: #ECE6D8; color: #2A2620; box-shadow: 0 18px 40px rgba(0, 0, 0, .35); transform: rotate(-3.5deg); }
  .carte .badge { width: 132px; height: 132px; flex: none; border-radius: 50%; object-fit: cover; }
  .carte figcaption { display: grid; gap: 8px; }
  .carte p { margin: 0; font: italic 400 1.2rem/1.35 var(--serif); color: #2A2620; }
  .signature-carte { width: 150px; height: auto; opacity: .85; }
  .colonne-form { display: grid; gap: 28px; width: 100%; }
  .rappel { display: flex; align-items: center; gap: 16px; padding: 12px 22px 12px 12px; border: 1px solid var(--trait); width: fit-content; max-width: 620px; color: var(--texte); }
  .rappel[hidden] { display: none; }
  .rappel img { width: 72px; height: 72px; object-fit: cover; flex: none; }
  .rappel span { display: grid; gap: 2px; }
  .rappel em { font: italic 400 1.25rem/1.2 var(--serif); color: var(--encre); }
  .rappel small { font-size: .85rem; }
  .rappel .retour-piece { color: var(--or); letter-spacing: .04em; }
  .rappel:hover { border-color: var(--or); }
  /* Ordinateur : formulaire plus serré (2026-10-30, Gwen) pour que son bas tombe à peu près au niveau du bas de la carte. */
  @media (min-width: 900px) {
    /* Tout visible sans défiler, au moins jusqu'à la pointe basse de la carte (2026-10-30, Gwen, écran 1920 × 1080 zoomé à 125 %). */
    .haut-page { padding-top: 28px; }
    .pile { gap: 14px; }
    .coord { gap: 0; }
    .rappel { padding: 8px 18px 8px 8px; gap: 14px; }
    .rappel img { width: 58px; height: 58px; }
    .carte { margin-top: auto; padding: 20px 24px; gap: 18px; translate: 0 .7cm; } /* collée en bas, puis descendue de 0,7 cm (Gwen, 2026-10-30) */
    .carte .badge { width: 112px; height: 112px; }
    .colonne-form { gap: 18px; }
    .colonne-form :global(.formulaire) { gap: 16px; }
    .colonne-form :global(.deux) { gap: 16px 26px; }
    .colonne-form :global(label) { gap: 2px; }
    .colonne-form :global(textarea) { min-height: 0; height: 74px; }
    .colonne-form :global(.sujets legend) { margin-bottom: 6px; }
    .colonne-form :global(.puce span) { padding: 7px 16px; }
    .colonne-form :global(.pied) { gap: 8px; }
    /* Si la colonne de gauche est plus haute, le champ Message s'allonge pour que le bas du formulaire rejoigne le bas de la carte. */
    .haut-page { align-items: stretch; }
    .colonne-form { display: flex; flex-direction: column; }
    .colonne-form :global(.formulaire) { display: flex; flex-direction: column; flex: 1; }
    .colonne-form :global(label:has(textarea)) { flex: 1; display: flex; flex-direction: column; }
    .colonne-form :global(label:has(textarea) textarea) { flex: 1; }
  }
  @media (max-width: 600px) { .carte { transform: rotate(-2deg); padding: 22px; gap: 16px; } .carte .badge { width: 96px; height: 96px; } }
</style>
