---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mur from '../components/Mur.astro';
import Temoignages from '../components/Temoignages.astro';
import Lieux from '../components/Lieux.astro';
import { photoOuvertureSanity } from '../sanity/reglages';
import { site } from '../data/site';

// Accueil : un chapitre Tableaux puis un chapitre Sculptures ; la galerie ne montre que les tableaux.
const collection = (await getCollection('oeuvres')).sort((a, b) => a.data.ordre - b.data.ordre);
const toutes = collection.filter((o) => o.data.type === 'tableau');
// Deuxième chapitre de l'accueil : les sculptures disponibles, pour que le récit ne se limite pas aux tableaux.
const sculptures = collection.filter((o) => o.data.type === 'sculpture' && o.data.statut !== 'vendue').slice(0, 3);
const disponibles = toutes.filter((o) => o.data.statut !== 'vendue').slice(0, 5);
const vedette =
  toutes.find((o) => o.data.accueil && o.data.statut !== 'vendue') ??
  toutes.find((o) => o.data.histoire && o.data.statut !== 'vendue');
// Image du grand rideau d'ouverture : celle choisie dans l'administration (Accueil › Photo d'ouverture),
// sinon, en attendant, la pièce mise en avant ou la première disponible.
const heroSource = vedette ?? disponibles[0];
const choisie = await photoOuvertureSanity();
const photoHero = choisie?.src ?? site.photoOuverture?.src ?? (heroSource ? (heroSource.data.photos[1] ?? heroSource.data.photos[0]).src : '/images/atelier.webp');
const positionHero = choisie?.position ?? site.photoOuverture?.position ?? 'center';
// Ouverture « mur de galerie » : seulement pour la photo par défaut du site, jamais pour une photo choisie
// dans l'administration (celles-ci restent des photos rectangulaires ordinaires, plein cadre).
const modeMur = !choisie && site.photoOuverture?.mode === 'mur';
const photoHeroMobile = modeMur ? (site.photoOuverture?.srcMobile ?? photoHero) : photoHero;
---
<Base title="Adelem" accueil>
  <section class={modeMur ? 'hero-pin hero-mur' : 'hero-pin'}>
    <div class="hero-fixe">
      <div class="hero-photo" style={`--photo: url(${photoHero}); --photo-mobile: url(${photoHeroMobile}); --position: ${positionHero}`} role={choisie?.alt ? 'img' : undefined} aria-label={choisie?.alt || undefined}></div>
      <div class="marque-hero">
        <img class="signature" src="/logo/adelem-signature-droite.svg" alt="Adelem" width="380" height="172" />
      </div>
      {modeMur && <p class="accroche">La nature entre chez vous</p>}
      <p class="indice" aria-hidden="true"><span>Découvrir</span></p>
    </div>
  </section>

  <section class="ouverture">
    <div class="wrap intro">
      <h1>Tableaux de mousses et de lichens, sculptures, faits à la main</h1>
      <p class="discret">Pièces uniques</p>
    </div>
    <div class="wrap">
      {disponibles.length ? <Mur oeuvres={disponibles} eager /> : <p class="discret vide">Les premières œuvres arrivent.</p>}
      <p class="discret echelle">Les œuvres sont présentées à leur échelle réelle les unes par rapport aux autres.</p>
      <p class="centre"><a class="lien" href="/galerie">Toute la galerie</a></p>
    </div>
  </section>

  {sculptures.length > 0 && (
    <section class="wrap bloc chapitre" data-reveal>
      <div class="intro">
        <h2 class="titre-section">Sculptures</h2>
        <p class="texte">Le même regard, une autre matière.</p>
      </div>
      <Mur oeuvres={sculptures} echelleLocale />
      <p class="centre"><a class="lien" href="/sculptures">Toutes les sculptures</a></p>
    </section>
  )}

  {vedette && (
    <section class="wrap bloc duo vedette" data-reveal>
      <img src={(vedette.data.photos[1] ?? vedette.data.photos[0]).src} alt={vedette.data.photos[1]?.alt ?? vedette.data.photos[0].alt} loading="lazy" width="1000" height="1200" />
      <div class="pile">
        <h2 class="titre-section">{vedette.data.titre}</h2>
        {vedette.data.histoire && <p class="texte">{vedette.data.histoire}</p>}
        <a class="lien" href={`/oeuvres/${vedette.id}`}>Voir l’œuvre</a>
      </div>
    </section>
  )}

  <section class="wrap bloc duo" data-reveal>
    <div class="pile">
      <h2 class="titre-section">Un vrai travail de main</h2>
      <p class="texte">Chercher un cadre ancien, le restaurer, composer, attendre les séchages, reprendre un relief. Un grand format demande huit à dix jours de travail.</p>
      <a class="lien" href="/atelier">Découvrir l’atelier</a>
    </div>
    <img src="/images/atelier.webp" alt="Main posée sur un tapis de mousse" loading="lazy" width="1400" height="933" class="photo-atelier" />
  </section>

  <Temoignages />
  <Lieux />

  <script>
    const cibles = document.querySelectorAll('[data-reveal]');
    cibles.forEach((el) => el.classList.add('reveal'));
    if ('IntersectionObserver' in window && cibles.length) {
      const observateur = new IntersectionObserver((entrees) => {
        entrees.forEach((entree) => {
          if (entree.isIntersecting) {
            entree.target.classList.add('visible');
            observateur.unobserve(entree.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      cibles.forEach((el) => observateur.observe(el));
    } else {
      cibles.forEach((el) => el.classList.add('visible'));
    }
  </script>
</Base>

<style>
  /* Rideau d'ouverture : la signature reste fixée à l'écran pendant que l'on entre dans le site,
     puis se libère lorsque l'accroche défile par-dessus — inspiré des ouvertures des maisons de luxe. */
  .hero-pin { position: relative; height: 140dvh; }
  .hero-fixe { position: sticky; top: 0; height: 100dvh; overflow: hidden; }
  .hero-photo { position: absolute; inset: 0; background-image: var(--photo); background-size: cover; background-position: var(--position, center); }
  /* Halo sombre et doux derrière la signature : elle se détache de n'importe quelle photo, même chargée,
     sans assombrir toute l'image. Plus large sur grand écran, où la photo montre davantage de détails. */
  .hero-photo::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(ellipse 60% 34% at 50% 52%, rgba(20, 24, 20, .62), rgba(20, 24, 20, 0) 100%);
  }
  @media (min-width: 820px) {
    .hero-photo::before { background: radial-gradient(ellipse 42% 38% at 50% 52%, rgba(20, 24, 20, .72), rgba(20, 24, 20, 0) 100%); }
    .signature { width: min(480px, 36vw); }
  }
  /* Mobile : léger décalage optique (la grande boucle de gauche déporte le mot vers la droite). */
  @media (max-width: 819px) { .signature { transform: translateX(-6%); } }
  /* Voile léger au centre pour garder les couleurs de la photo, plus sombre en haut (menu lisible)
     et en bas (fondu vers le mur). */
  .hero-photo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 24, 20, .72) 0, rgba(20, 24, 20, .35) 120px, rgba(20, 24, 20, 0) 220px),
      linear-gradient(180deg, rgba(27, 33, 27, .55) 0%, rgba(27, 33, 27, .18) 22%, rgba(27, 33, 27, .3) 55%, rgba(27, 33, 27, .7) 82%, var(--mur) 100%);
  }
  /* Invitation discrète à faire défiler, en bas de l'ouverture. */
  .indice { position: absolute; left: 0; right: 0; bottom: 28px; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: var(--encre); opacity: .8; }
  .indice::after { content: ''; width: 1px; height: 36px; background: linear-gradient(var(--encre), transparent); }
  /* Sur mobile, l'ouverture est plus courte : la première œuvre arrive plus vite. */
  @media (max-width: 819px) { .hero-pin { height: 108dvh; } }
  .marque-hero {
    position: relative; height: 100%; z-index: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    text-align: center; padding: 0 24px;
  }
  .signature { width: min(380px, 80vw); height: auto; filter: invert(.92) drop-shadow(0 2px 14px rgba(0, 0, 0, .45)); opacity: .97; }

  /* Ouverture « mur de galerie » : le tableau est posé sur un mur de la couleur du site ; la signature
     se place au-dessus de lui, comme le nom de l'artiste peint sur le mur d'une galerie. Pas de halo
     derrière la signature (le mur est déjà sombre) et un fondu bas plus tardif pour ne pas éteindre le cadre. */
  .hero-mur .hero-photo { background-image: var(--photo-mobile); }
  @media (min-width: 820px) { .hero-mur .hero-photo { background-image: var(--photo); } }
  .hero-mur .hero-photo::before { display: none; }
  .hero-mur .hero-photo::after {
    background:
      linear-gradient(180deg, rgba(20, 24, 20, .55) 0, rgba(20, 24, 20, 0) 140px),
      linear-gradient(180deg, rgba(27, 33, 27, 0) 84%, var(--mur) 100%);
  }
  /* La signature est calée sur le haut réel du cadre, quel que soit le format d'écran.
     --cadre-haut = position du haut du cadre une fois l'image recadrée en « cover » :
     milieu de l'écran − (distance centre→haut du cadre dans l'image) × échelle de l'image.
     Mobile (image 1080 × 2340, haut du cadre à 221 px au-dessus du centre) ;
     ordinateur (image 2560 × 1440, haut du cadre à 288 px au-dessus du centre).
     Si les images d'ouverture changent de cadrage, ces deux formules sont à recalculer. */
  .hero-mur .hero-fixe {
    --cadre-haut: calc(50dvh - max(20.46vw, 9.44dvh));
    /* Bas du cadre, même calcul : 426 px sous le centre de l'image mobile (1080 × 2340). */
    --cadre-bas: calc(50dvh + max(39.44vw, 18.21dvh));
  }
  .hero-mur .marque-hero {
    position: absolute; top: 0; left: 0; right: 0;
    height: calc(var(--cadre-haut) - 22px);
    justify-content: flex-end; padding-top: 0;
  }
  /* Signature redressée (adelem-signature-droite.svg : rotation de 9,16° pour mettre à plat la ligne de base
     de « delem »). Le mot est centré sans la grande boucle de gauche : son étendue va du pied gauche du A
     (x = 450 sur 1533) à la fin du m (x = 1527), milieu à 988,5 au lieu du centre de la boîte (766,5).
     Décalage = (766,5 − 988,5) / 1533 = −14,48 % de la largeur. */
  .hero-mur .signature { width: min(300px, 70vw); transform: translateX(-14.48%); }
  @media (min-width: 820px) {
    .hero-mur .hero-fixe {
      --cadre-haut: calc(50dvh - max(11.25vw, 20dvh));
      /* Bas du cadre : 403 px sous le centre de l'image ordinateur (2560 × 1440). */
      --cadre-bas: calc(50dvh + max(15.74vw, 27.99dvh));
    }
    /* Hauteur pilotée par la place disponible entre le menu et le cadre (largeur déduite). */
    .hero-mur .signature { width: auto; height: clamp(64px, calc(var(--cadre-haut) - 80px), 240px); }
  }
  .hero-mur .indice { bottom: 14px; }
  /* Accroche posée sous le tableau, comme un cartel de galerie (recalculer --cadre-bas si l'image change). */
  .accroche {
    position: absolute; left: 0; right: 0; z-index: 1; margin: 0; padding: 0 24px;
    top: calc(var(--cadre-bas) + clamp(18px, 3dvh, 30px));
    text-align: center; color: var(--encre);
    font: italic 300 clamp(1.2rem, 0.9rem + 1vw, 1.75rem)/1.3 var(--serif); letter-spacing: .02em;
  }

  .ouverture { position: relative; z-index: 1; background: var(--mur); padding-top: clamp(56px, 8vw, 96px); }
  .intro { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: clamp(48px, 7vw, 88px); }
  .intro h1 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-style: italic; line-height: 1.35; max-width: 26em; }
  .echelle, .centre { text-align: center; }
  .echelle { margin-bottom: 20px; }
  .vide { text-align: center; padding: 80px 0; }
  .chapitre .centre { margin-top: 40px; }
  .vedette img { width: 100%; height: auto; }
  .photo-atelier { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .reveal { opacity: 0; transform: translateY(28px); transition: opacity .9s ease, transform .9s cubic-bezier(.16, 1, .3, 1); }
  .reveal.visible { opacity: 1; transform: none; }
</style>
