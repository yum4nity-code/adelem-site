---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mur from '../components/Mur.astro';
import Temoignages from '../components/Temoignages.astro';
import Lieux from '../components/Lieux.astro';

// Accueil : un chapitre Tableaux puis un chapitre Sculptures ; la galerie « Œuvres » ne montre que les tableaux.
const collection = (await getCollection('oeuvres')).sort((a, b) => a.data.ordre - b.data.ordre);
const toutes = collection.filter((o) => o.data.type === 'tableau');
// Deuxième chapitre de l'accueil : les sculptures disponibles, pour que le récit ne se limite pas aux tableaux.
const sculptures = collection.filter((o) => o.data.type === 'sculpture' && o.data.statut !== 'vendue').slice(0, 3);
const disponibles = toutes.filter((o) => o.data.statut !== 'vendue').slice(0, 5);
const vedette =
  toutes.find((o) => o.data.accueil && o.data.statut !== 'vendue') ??
  toutes.find((o) => o.data.histoire && o.data.statut !== 'vendue');
// Image d'ambiance du grand rideau d'ouverture : la pièce mise en avant, sinon la première disponible.
const heroSource = vedette ?? disponibles[0];
const photoHero = heroSource ? (heroSource.data.photos[1] ?? heroSource.data.photos[0]).src : '/images/atelier.webp';
---
<Base title="Adelem">
  <section class="hero-pin">
    <div class="hero-fixe">
      <div class="hero-photo" style={`background-image: url(${photoHero})`}></div>
      <div class="marque-hero">
        <img class="signature" src="/logo/adelem-wordmark-charcoal.svg" alt="Adelem" width="220" height="178" />
      </div>
    </div>
  </section>

  <section class="ouverture">
    <div class="wrap intro">
      <h1>Tableaux de mousses et de lichens, sculptures, faits à la main</h1>
      <p class="discret">Pièces uniques</p>
    </div>
    <div class="wrap">
      {disponibles.length ? <Mur oeuvres={disponibles} eager /> : <p class="discret vide">Les premières œuvres arrivent.</p>}
      <p class="discret echelle">Les œuvres sont présentées à leur échelle réelle les unes par rapport aux autres.</p>
      <p class="centre"><a class="lien" href="/galerie">Toutes les œuvres</a></p>
    </div>
  </section>

  {sculptures.length > 0 && (
    <section class="wrap bloc chapitre" data-reveal>
      <div class="intro">
        <h2 class="titre-section">Sculptures</h2>
        <p class="texte">Le même regard, une autre matière.</p>
      </div>
      <Mur oeuvres={sculptures} />
      <p class="centre"><a class="lien" href="/sculptures">Toutes les sculptures</a></p>
    </section>
  )}

  {vedette && (
    <section class="wrap bloc duo vedette" data-reveal>
      <img src={(vedette.data.photos[1] ?? vedette.data.photos[0]).src} alt={vedette.data.photos[1]?.alt ?? vedette.data.photos[0].alt} loading="lazy" width="1000" height="1200" />
      <div class="pile">
        <h2 class="titre-section">{vedette.data.titre}</h2>
        {vedette.data.histoire && <p class="texte">{vedette.data.histoire}</p>}
        <a class="lien" href={`/oeuvres/${vedette.id}`}>Voir l’œuvre</a>
      </div>
    </section>
  )}

  <section class="wrap bloc duo" data-reveal>
    <div class="pile">
      <h2 class="titre-section">Un vrai travail de main</h2>
      <p class="texte">Chercher un cadre ancien, le restaurer, composer, attendre les séchages, reprendre un relief. Un grand format demande huit à dix jours de travail.</p>
      <a class="lien" href="/atelier">Découvrir l’atelier</a>
    </div>
    <img src="/images/atelier.webp" alt="Main posée sur un tapis de mousse" loading="lazy" width="1400" height="933" class="photo-atelier" />
  </section>

  <Temoignages />
  <Lieux />

  <script>
    const cibles = document.querySelectorAll('[data-reveal]');
    cibles.forEach((el) => el.classList.add('reveal'));
    if ('IntersectionObserver' in window && cibles.length) {
      const observateur = new IntersectionObserver((entrees) => {
        entrees.forEach((entree) => {
          if (entree.isIntersecting) {
            entree.target.classList.add('visible');
            observateur.unobserve(entree.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      cibles.forEach((el) => observateur.observe(el));
    } else {
      cibles.forEach((el) => el.classList.add('visible'));
    }
  </script>
</Base>

<style>
  /* Rideau d'ouverture : la signature reste fixée à l'écran pendant que l'on entre dans le site,
     puis se libère lorsque l'accroche défile par-dessus — inspiré des ouvertures des maisons de luxe. */
  .hero-pin { position: relative; height: 140dvh; }
  .hero-fixe { position: sticky; top: 0; height: 100dvh; overflow: hidden; }
  .hero-photo { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .hero-photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(27, 33, 27, .45) 0%, rgba(27, 33, 27, .82) 68%, var(--mur) 100%);
  }
  .marque-hero {
    position: relative; height: 100%; z-index: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    text-align: center; padding: 0 24px;
  }
  .signature { width: min(260px, 55vw); height: auto; filter: invert(.92); opacity: .97; }

  .ouverture { position: relative; z-index: 1; background: var(--mur); padding-top: clamp(56px, 8vw, 96px); }
  .intro { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: clamp(48px, 7vw, 88px); }
  .intro h1 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-style: italic; line-height: 1.35; max-width: 26em; }
  .echelle, .centre { text-align: center; }
  .echelle { margin-bottom: 20px; }
  .vide { text-align: center; padding: 80px 0; }
  .chapitre .centre { margin-top: 40px; }
  .vedette img { width: 100%; height: auto; }
  .photo-atelier { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .reveal { opacity: 0; transform: translateY(28px); transition: opacity .9s ease, transform .9s cubic-bezier(.16, 1, .3, 1); }
  .reveal.visible { opacity: 1; transform: none; }
</style>
