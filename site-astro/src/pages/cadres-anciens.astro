---
import Base from '../layouts/Base.astro';
---
<Base title="Cadres anciens" description="Des cadres anciens, chinés puis restaurés, qui participent à la composition de chaque tableau végétal.">
  <section class="wrap duo haut-page">
    <div class="pile">
      <h1 class="titre-section">Le cadre participe à l’œuvre</h1>
      <p class="texte">Les cadres anciens sont chinés puis restaurés. Ils donnent un format, une profondeur, et orientent les vides comme la densité.</p>
      <a class="lien" href="/galerie">Voir la galerie</a>
    </div>
    <img src="/oeuvres/clairiere/cadre.webp" alt="Moulure d’un cadre ancien restauré" width="1000" height="1500" class="photo" />
  </section>
</Base>
<style>
  .haut-page { padding-top: clamp(40px, 6vw, 80px); }
  .photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
</style>
