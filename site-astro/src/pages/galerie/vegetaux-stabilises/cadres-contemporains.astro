---
import { getCollection } from 'astro:content';
import SalleGalerie from '../../../components/SalleGalerie.astro';
import { collectionsVegetaux } from '../../../data/galerie';
import { textesGalerieSanity } from '../../../sanity/reglages';
const c = collectionsVegetaux.find((x) => x.cle === 'contemporain')!;
const textes = await textesGalerieSanity();
const oeuvres = (await getCollection('oeuvres')).filter((o) => o.data.type === 'tableau' && o.data.collection === c.cle);
---
<SalleGalerie titre={c.nom} texte={textes[c.cle] ?? c.texte} oeuvres={oeuvres} fil={[{ nom: 'Galerie', href: '/galerie' }, { nom: 'Végétaux stabilisés', href: '/galerie/vegetaux-stabilises' }]} />
