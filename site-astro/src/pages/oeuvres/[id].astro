---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import BarreAchat from '../../components/BarreAchat.astro';
import Prevenir from '../../components/Prevenir.astro';
import Vignettes from '../../components/Vignettes.astro';
import Suggestions from '../../components/Suggestions.astro';
import { prix, site, dims, resume } from '../../data/site';
import { pageDe } from '../../data/galerie';
import { apercuCompose } from '../../data/apercu';

export async function getStaticPaths() {
  const oeuvres = await getCollection('oeuvres');
  return oeuvres.map((o) => ({ params: { id: o.id }, props: { oeuvre: o } }));
}
const { oeuvre } = Astro.props;
const d = oeuvre.data;
const [face] = d.photos;
const rubrique = pageDe(oeuvre); // page de la galerie où se trouve l'œuvre
const disponible = d.statut === 'disponible';
const annee = d.statut === 'vendue' ? d.annee : null; // année affichée seulement pour les pièces vendues
// Paiement : page Stripe créée au clic par /api/acheter, au prix du site (option B). Les œuvres d'exemple, sans
// identifiant Sanity, gardent leur ancien lien de paiement.
const paiementSite = disponible && d.sanity_id && d.prix && site.paiement !== 'off'
  ? `/oeuvres/${oeuvre.id}/acquerir` // page de paiement intégrée (2026-11-01)
  : null;
const achat = paiementSite ?? (disponible && d.lien_paiement ? d.lien_paiement : null);
// Lien Stripe de test (buy.stripe.com/test_…) : bouton caché aux visiteurs, visible seulement en « mode test »
// (ouvrir une page avec ?test-paiement, désactiver avec ?test-paiement=non). Un vrai lien s'affiche pour tout le monde.
const achatTest = !!achat && (paiementSite ? site.paiement === 'test' : /\/test_/.test(achat));
// Aperçu de partage : prix (ou statut) en tête, puis le début du texte ; image composée pour les pièces verticales.
const enTete = d.statut === 'vendue' ? 'Collection privée · Pièce unique'
  : d.statut === 'reservee' ? 'Réservée · Pièce unique'
  : d.prix ? `${prix(d.prix)} · Pièce unique · Livraison offerte en France métropolitaine` : 'Pièce unique';
const descriptionPartage = `${enTete}. ${resume(d.histoire ?? `${d.titre}, pièce unique d’Adelem.`, Math.max(60, 190 - enTete.length))}`;
const imagePartage = apercuCompose(d) ? `/partage/${oeuvre.id}.jpg` : face.og ?? face.src;
const contactPiece = `/contact?piece=${encodeURIComponent(d.titre)}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': d.type === 'sculpture' ? 'Sculpture' : 'VisualArtwork',
  name: d.titre,
  creator: { '@type': 'Organization', name: site.nom },
  image: d.photos.map((p) => new URL(p.src, site.url).href),
  ...(annee ? { dateCreated: String(annee) } : {}),
  width: `${d.largeur_cm} cm`,
  height: `${d.hauteur_cm} cm`,
  artMedium: d.matieres.join(', '),
  ...(d.statut !== 'vendue' && d.prix
    ? { offers: { '@type': 'Offer', price: d.prix, priceCurrency: 'EUR', availability: disponible ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut', url: new URL(`/oeuvres/${oeuvre.id}`, site.url).href } }
    : {}),
};
---
<Base title={d.titre} description={descriptionPartage} image={imagePartage} jsonld={jsonld}>
  <section class="wrap tete">
    <div class="oeuvre" data-galerie>
      <div class="photo-principale" style={`--l:${d.largeur_cm};--h:${d.hauteur_cm}`} data-loupe>
        <img id="vue-principale" src={face.src} alt={face.alt} width={d.largeur_cm * 10} height={d.hauteur_cm * 10} />
        <span class="loupe" aria-hidden="true"></span>
        {d.statut === 'vendue' && <span class="pastille-vendue" aria-hidden="true">Collection privée</span>}
      </div>
      <p class="indice-loupe discret">Passez la souris sur l’œuvre pour voir la matière de près.</p>
      <Vignettes photos={d.photos} cible="vue-principale" />
    </div>
    <div class="infos">
      <a class="etiquette" href={rubrique.href}><span aria-hidden="true">←</span> {rubrique.nom} · Pièce unique</a>
      <h1>{d.titre}</h1>
      {d.sous_titre && <p class="sous-titre">{d.sous_titre}</p>}
      {annee && <p class="annee">{annee}</p>}
      <p class="ligne-prix">
        <span class="prix">{d.statut === 'vendue' ? 'Collection privée' : d.statut === 'reservee' ? <>Réservée{d.prix ? <small class="prix-reserve">{prix(d.prix)}</small> : null}</> : prix(d.prix)}</span>
        <span class="droite">
          <span class="taille">{dims(d.largeur_cm, d.hauteur_cm)}</span>
          <button type="button" class="partager" data-partager data-titre={d.titre} title="Partager" aria-label="Partager cette pièce">
            <svg class="icone-ios" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 9H6.5v11.5h11V9h-2"/><path d="M12 14.5V3.5"/><path d="M8.5 7 12 3.5 15.5 7"/></svg>
            <svg class="icone-autre" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="17.5" cy="5.5" r="2.5"/><circle cx="6.5" cy="12" r="2.5"/><circle cx="17.5" cy="18.5" r="2.5"/><path d="m8.7 10.7 6.6-3.9M8.7 13.3l6.6 3.9"/></svg>
          </button>
          <span class="copie-partage" role="status" aria-live="polite"></span>
        </span>
      </p>
      {d.statut === 'vendue' ? (
        <div class="liens">
          <Prevenir piece={d.titre} />
          <a class="lien secondaire" href={rubrique.href}>Voir les pièces disponibles</a>
        </div>
      ) : d.statut === 'reservee' ? (
        <div class="liens">
          <Prevenir piece={d.titre} reservee />
          <a class="lien secondaire" href={rubrique.href}>Voir les pièces disponibles</a>
        </div>
      ) : achat ? (
        <>
        <div class="liens" data-paiement-test={achatTest ? '' : undefined} hidden={achatTest}>
          {achatTest && <p class="mode-test">Mode test · aucun vrai paiement</p>}
          <a class="bouton achat" href={achat} data-achat>Acquérir cette pièce</a>
        </div>
        {achatTest && (
          <div class="liens" data-sans-paiement-test>
            <a class="bouton achat" href={contactPiece}>Demander cette œuvre</a>
          </div>
        )}
        </>
      ) : (
        <div class="liens">
          <a class="bouton achat" href={contactPiece}>Demander cette œuvre</a>
        </div>
      )}
      {d.statut === 'disponible' && (
        <p class="atouts">Livraison offerte en France métropolitaine{d.type === 'tableau' && <> · Sans arrosage ni entretien</>}</p>
      )}
      {d.statut === 'disponible' && <a class="lien secondaire question" href={contactPiece}>Une question sur cette pièce ?</a>}
      {d.histoire && (
        <div class="histoire" data-replie>
          <p id="description-oeuvre">{d.histoire}</p>
          <button type="button" class="lire-suite" aria-controls="description-oeuvre" aria-expanded="false" hidden>Lire la suite</button>
        </div>
      )}
      <div class="volets">
        <details>
          <summary>Matières et dimensions</summary>
          <div class="volet">
            <Cartel oeuvre={oeuvre} long />
            <p>Pièce unique, signée.</p>
            {d.certificat && <p>{d.certificat}</p>}
          </div>
        </details>
        {d.entretien && (
          <details>
            <summary>Entretien</summary>
            <div class="volet"><p>{d.entretien}</p></div>
          </details>
        )}
        <details>
          <summary>Livraison et retours</summary>
          <div class="volet">
            <p>Livraison offerte en France métropolitaine et à Monaco. Ailleurs en Europe, supplément selon le poids du colis, affiché au paiement ; outre-mer et reste du monde sur devis.</p>
            <p>Expédition sous 3 à 5 jours ouvrés.</p>
            <p><a href="/livraison">Emballage et livraison en détail</a></p>
          </div>
        </details>
      </div>
    </div>
  </section>



  {/* Plus de formulaire sous la fiche (2026-10-30, Gwen) : « Demander » et « Une question » mènent à /contact,
      qui affiche la miniature de la pièce et un lien pour y revenir. */}
  <Suggestions oeuvre={oeuvre} />

  {achat && <BarreAchat titre={d.titre} prix={prix(d.prix)} lien={achat} />}
</Base>

<script>
  // Partage : menu natif du téléphone (WhatsApp, Messages…), sinon lien copié. Icône adaptée (flèche sur Apple, trois points ailleurs).
  if (/iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent)) document.documentElement.classList.add('ios');
  document.querySelectorAll<HTMLButtonElement>('[data-partager]').forEach((b) => {
    const statut = b.parentElement?.querySelector('.copie-partage');
    b.addEventListener('click', async () => {
      const url = location.origin + location.pathname;
      // Si le menu de partage du téléphone refuse de s'ouvrir (erreur autre qu'une annulation), on copie le lien
      // au lieu de ne rien faire (2026-11-07, signalé sur Android).
      if (navigator.share) {
        try { await navigator.share({ title: b.dataset.titre, url }); return; }
        catch (e) { if ((e as DOMException)?.name === 'AbortError') return; }
      }
      try { await navigator.clipboard.writeText(url); if (statut) statut.textContent = 'Lien copié'; }
      catch { if (statut) statut.textContent = url; }
      setTimeout(() => { if (statut) statut.textContent = ''; }, 2500);
    });
  });
</script>

<script>
  // Loupe : suit la souris sur la photo principale et montre la même photo grossie 2,5 fois.
  // Tient compte de la photo affichée (les vignettes la changent) et de son cadrage (« cover » ou « contain »).
  const zone = document.querySelector<HTMLElement>('[data-loupe]');
  if (zone && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const img = zone.querySelector('img')!;
    const loupe = zone.querySelector<HTMLElement>('.loupe')!;
    const Z = 2.5;
    const bouger = (e: PointerEvent) => {
      const r = img.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      if (x < 0 || y < 0 || x > r.width || y > r.height || !img.naturalWidth) { zone.classList.remove('loupe-active'); return; }
      // Taille et position de l'image réellement dessinée dans la boîte.
      const contenir = getComputedStyle(img).objectFit === 'contain';
      const k = (contenir ? Math.min : Math.max)(r.width / img.naturalWidth, r.height / img.naturalHeight);
      const w = img.naturalWidth * k, h = img.naturalHeight * k;
      const ox = (r.width - w) / 2, oy = (r.height - h) / 2;
      const taille = loupe.offsetWidth / 2;
      loupe.style.backgroundImage = `url("${img.currentSrc || img.src}")`;
      loupe.style.backgroundSize = `${w * Z}px ${h * Z}px`;
      loupe.style.backgroundPosition = `${taille - (x - ox) * Z}px ${taille - (y - oy) * Z}px`;
      loupe.style.left = x + 'px';
      loupe.style.top = y + 'px';
      zone.classList.add('loupe-active');
    };
    zone.addEventListener('pointermove', bouger);
    zone.addEventListener('pointerleave', () => zone.classList.remove('loupe-active'));
  }
</script>
<script>
  // Mode test des paiements : mémorisé sur cet appareil, jamais visible des visiteurs ordinaires.
  {
    let actif = false;
    try {
      const q = new URLSearchParams(location.search).get('test-paiement');
      if (q !== null) localStorage.setItem('adelem-test-paiement', q === 'non' ? '' : '1');
      actif = localStorage.getItem('adelem-test-paiement') === '1';
    } catch {}
    if (actif) {
      document.querySelector('[data-paiement-test]')?.removeAttribute('hidden');
      document.querySelectorAll('[data-sans-paiement-test]').forEach((e) => e.setAttribute('hidden', ''));
    }
  }
</script>
<script>
  // Description : coupée à 3 lignes si elle est plus longue, avec « … » et « Lire la suite » / « Réduire ».
  // Coupe faite en script, à un mot entier, ponctuation finale retirée : jamais de « textures.… ».
  const bloc = document.querySelector<HTMLElement>('[data-replie]');
  if (bloc) {
    const texte = bloc.querySelector('p')!;
    const bouton = bloc.querySelector<HTMLButtonElement>('.lire-suite')!;
    const complet = texte.textContent ?? '';
    const mots = complet.split(' ');
    let ouvert = false;
    const couper = () => {
      texte.textContent = complet;
      if (ouvert) return;
      const max = parseFloat(getComputedStyle(texte).lineHeight) * 3 + 2;
      if (texte.offsetHeight <= max) { bouton.hidden = true; return; }
      bouton.hidden = false;
      let bas = 1, haut = mots.length - 1;
      const essai = (k: number) => mots.slice(0, k).join(' ').replace(/[\s.,;:!?…·—–-]+$/u, '') + '…';
      while (bas < haut) {
        const k = Math.ceil((bas + haut) / 2);
        texte.textContent = essai(k);
        if (texte.offsetHeight <= max) bas = k; else haut = k - 1;
      }
      texte.textContent = essai(bas);
    };
    couper();
    let attente: number;
    addEventListener('resize', () => { clearTimeout(attente); attente = window.setTimeout(couper, 120); });
    document.fonts?.ready.then(couper);
    bouton.addEventListener('click', () => {
      ouvert = !ouvert;
      bouton.setAttribute('aria-expanded', String(ouvert));
      bouton.textContent = ouvert ? 'Réduire' : 'Lire la suite';
      couper();
      if (!ouvert) bloc.scrollIntoView({ block: 'nearest' });
    });
  }
</script>

<style>
  .mode-test { margin: 0 0 4px; font: 500 .7rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: #e0a96d; }
  /* Retour vers la rubrique de l'œuvre : visible, assez grand pour le doigt. */
  /* Étiquette = retour vers la rubrique : « ← Signature · Pièce unique ». */
  .etiquette { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font: 500 .72rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--or); }
  .etiquette:hover { color: var(--encre); }
  .ligne-prix { align-self: stretch; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 4px 0 0; }
  .prix-reserve { margin-left: 14px; font: 400 1rem var(--sans); color: var(--discret); vertical-align: middle; }
  .taille { font-size: .92rem; color: var(--texte); }
  .droite { position: relative; display: inline-flex; align-items: center; gap: 14px; }
  .partager { display: inline-grid; place-items: center; width: 40px; height: 40px; margin: -10px -10px -10px 0; padding: 0; border: 0; background: none; color: var(--texte); cursor: pointer; transition: color .2s; }
  .partager:hover { color: var(--or); }
  .partager .icone-ios, :global(html.ios) .partager .icone-autre { display: none; }
  :global(html.ios) .partager .icone-ios { display: block; }
  .copie-partage { position: absolute; right: 0; bottom: 100%; margin-bottom: 8px; font: 400 .75rem/1 var(--sans); color: var(--discret); white-space: nowrap; }
  .bouton.achat { align-self: stretch; text-align: center; padding: 20px 32px; font-size: .82rem; }
  .atouts { align-self: stretch; text-align: center; margin: -4px 0 0; font-size: .88rem; color: var(--texte); }
  .question { align-self: center; }
  .volets { align-self: stretch; border-top: 1px solid var(--trait); margin-top: 6px; }
  .volets details { border-bottom: 1px solid var(--trait); }
  .volets summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; min-height: 64px; font: 400 1.3rem var(--serif); color: var(--encre); }
  .volets summary::-webkit-details-marker { display: none; }
  .volets summary::after { content: '+'; font: 300 1.5rem var(--sans); color: var(--or); }
  .volets details[open] summary::after { content: '–'; }
  .volet { padding: 0 0 22px; display: flex; flex-direction: column; gap: 10px; font-size: .95rem; line-height: 1.75; color: var(--texte); }
  .volet p { margin: 0; }
  .volet a { color: var(--encre); text-decoration: underline; text-underline-offset: 2px; }
  .tete { display: grid; gap: clamp(40px, 6vw, 96px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); align-items: start; /* image en haut, alignée sur le début des infos (2026-10-30) */ padding-top: clamp(32px, 5vw, 64px); }
  .oeuvre { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 40px 0; }
  /* Hauteur plafonnée à 72 % de l'écran (2026-11-01) : une pièce très étroite (Rêveuse, 6 × 26 cm) prenait 4 écrans de
     haut sur téléphone, car la largeur minimale de 300 px s'appliquait quelle que soit la hauteur. La loupe et les vignettes
     permettent toujours de voir les détails. */
  .photo-principale { position: relative; width: min(100%, max(300px, calc(var(--l) * 7px)), calc(72svh * var(--l) / var(--h))); }
  .photo-principale > img {
    width: 100%; height: auto; aspect-ratio: var(--l) / var(--h); object-fit: cover;
    filter: drop-shadow(0 18px 26px rgba(0, 0, 0, .6)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
  }
  .photo-principale .pastille-vendue { position: absolute; top: -12px; right: -14px; font-size: 1.05rem; }
  /* Loupe sur la matière (2026-10-30, Gwen) : au survol à la souris, un rond grossit la mousse, le lichen, le bois.
     Seulement avec une souris ; sur téléphone, rien ne change. */
  .loupe { display: none; }
  .indice-loupe { display: none; margin-top: -8px; }
  @media (hover: hover) and (pointer: fine) {
    .photo-principale { cursor: zoom-in; }
    .indice-loupe { display: block; }
    .loupe {
      display: block; position: absolute; left: 0; top: 0; width: 190px; height: 190px; margin: -95px 0 0 -95px; border-radius: 50%;
      border: 1px solid rgba(236, 233, 224, .55); box-shadow: 0 14px 34px rgba(0, 0, 0, .55), inset 0 0 0 1px rgba(0, 0, 0, .25);
      background-color: var(--mur); background-repeat: no-repeat; pointer-events: none;
      opacity: 0; transform: scale(.6); transition: opacity .25s ease, transform .3s cubic-bezier(.16, 1, .3, 1);
    }
    .photo-principale.loupe-active .loupe { opacity: 1; transform: none; }
  }
  .infos { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .infos h1 { font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1; }
  .sous-titre { font: italic 300 clamp(1.35rem, 2.2vw, 1.7rem)/1.3 var(--serif); color: var(--encre); margin-top: -6px; }
  .annee { font: italic 300 1.4rem var(--serif); color: var(--texte); margin-top: -10px; }
  .prix { font: 400 1.9rem var(--serif); color: var(--encre); }
  .infos .discret a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .infos .discret a:hover { color: var(--encre); }
  .liens { align-self: stretch; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .liens[hidden] { display: none; }
  .secondaire { color: var(--texte); border-color: var(--trait); }
  .rassure { margin-top: -6px; }
  .histoire { max-width: 34em; }
  .histoire p { font-size: 1.02rem; line-height: 1.75; color: var(--texte); white-space: pre-line; }
  /* Description longue : coupée à 3 lignes par le script ; sans JavaScript, le texte reste entier. */
  .lire-suite { display: block; margin: 4px 0 0; min-height: 44px; padding: 0; background: none; border: 0; cursor: pointer; color: var(--or); font: 400 .78rem var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .lire-suite[hidden] { display: none; }
  .lire-suite:hover, .lire-suite:focus-visible { color: var(--encre); text-decoration: underline; text-underline-offset: 4px; }
  .entretien h2 { margin-bottom: 16px; }
  .entretien p { font-size: 1.02rem; line-height: 1.8; max-width: 34em; color: var(--texte); }
  .haut { align-items: start; }
  /* Téléphone (2026-11-06, Gwen) : l'œuvre, son nom et son prix tiennent sur le même écran. Photo plafonnée à 46 % de la
     hauteur (au lieu de 72 %), marges resserrées ; la loupe et les vignettes restent là pour les détails. */
  @media (max-width: 819px) {
    .tete { row-gap: 6px; padding-top: 10px; }
    .oeuvre { padding: 12px 0 0; gap: 12px; }
    /* Hauteur max : 46 % de l'écran, et jamais plus que l'écran moins ~350 px (en-tête, vignettes, nom, prix). */
    .photo-principale { --haut-max: max(200px, min(46svh, 100svh - 350px)); width: min(100%, max(200px, calc(var(--l) * 7px)), calc(var(--haut-max) * var(--l) / var(--h))); }
    .infos { gap: 12px; }
    .infos h1 { font-size: 2.4rem; }
    .sous-titre { font-size: 1.25rem; margin-top: -4px; }
    .annee { font-size: 1.2rem; margin-top: -6px; }
    .prix { font-size: 1.7rem; }
  }
</style>
