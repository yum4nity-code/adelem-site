---
// Page de paiement Adelem (refonte du 2026-11-20, Gwen : « construis-le en moderne »).
// Formulaire construit avec les éléments Stripe (Checkout Sessions, ui_mode « elements ») au lieu du formulaire
// Stripe tout fait : paiement express en premier (Apple Pay, Google Pay, PayPal), puis coordonnées, livraison et
// carte, aux couleurs du site. Paiement, sécurité, facture et passage en « vendue » restent gérés par Stripe
// (session créée par /api/acheter : prix du site, réservation 30 min, livraison, facture).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { prix, dims, site } from '../../../data/site';

export async function getStaticPaths() {
  const oeuvres = await getCollection('oeuvres');
  return oeuvres
    .filter((o) => (o.data.sanity_id || o.data.demo) && o.data.statut === 'disponible' && o.data.prix) // demo : aperçu local seulement
    .map((o) => ({ params: { id: o.id }, props: { oeuvre: o } }));
}
const { oeuvre } = Astro.props;
const d = oeuvre.data;
const face = d.photos[0];
const fiche = `/oeuvres/${oeuvre.id}`;
const details = [d.matieres.join(', '), d.cadre].filter(Boolean);
---
<Base title={`Acquérir ${d.titre}`} description={`Acquérir ${d.titre}, pièce unique Adelem.`} noindex>
  <script is:inline define:vars={{ resaPiece: d.sanity_id ?? oeuvre.id, resaRetour: fiche }}>
    // Vitesse (2026-11-21) : réservation et session Stripe demandées dès le début de la page, pendant que le reste
    // (images, polices, Stripe.js) se charge.
    if (location.hash.indexOf('cs=') === -1) {
      var resaJeton = null;
      try { resaJeton = localStorage.getItem('adelem-reservation-' + resaPiece); } catch (e) {}
      window.__adelemResa = fetch('/api/acheter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ piece: resaPiece, retour: resaRetour, jeton: resaJeton }) })
        .then(function (r) { return r.json(); });
    }
  </script>
  <section class="wrap caisse">
    <a class="retour" href={fiche}><span aria-hidden="true">←</span> Revenir à la pièce</a>

    <div class="grille">
      <!-- Récapitulatif : colonne de gauche sur ordinateur, bandeau repliable en haut sur téléphone. -->
      <aside class="recap" aria-label="Récapitulatif de la commande">
        <button type="button" class="recap-bandeau" aria-expanded="false" aria-controls="recap-detail" data-recap>
          <img src={face.detoure ?? face.src} alt="" width="56" height="56" />
          <span class="recap-titre">{d.titre}<small data-recap-libelle>Voir le détail</small></span>
          <span class="recap-total" data-total>{prix(d.prix)}</span>
        </button>
        <div class="recap-detail" id="recap-detail">
          <figure class="recap-photo">
            <img src={face.detoure ?? face.src} alt={face.alt} width={d.largeur_cm * 10} height={d.hauteur_cm * 10} style={`--l:${d.largeur_cm};--h:${d.hauteur_cm}`} />
          </figure>
          <p class="surtitre">Pièce unique, signée</p>
          <h1>{d.titre}</h1>
          {d.sous_titre && <p class="sous-titre">{d.sous_titre}</p>}
          <p class="cartel">{[...details, dims(d.largeur_cm, d.hauteur_cm)].join(' · ')}</p>
          <dl class="lignes">
            <div><dt>Pièce</dt><dd data-sous-total>{prix(d.prix)}</dd></div>
            <div><dt>Livraison <span data-livraison-nom>Colissimo, France</span></dt><dd data-livraison>Offerte</dd></div>
            <div class="ligne-total"><dt>Total</dt><dd data-total>{prix(d.prix)}</dd></div>
          </dl>
        </div>
        <div class="reservation" data-reservation hidden>
          <span class="point" aria-hidden="true"></span>
          <p><strong>Réservée pour vous</strong> <span data-reste></span><span class="resa-detail"> · personne d’autre ne peut l’acquérir d’ici <span data-heure></span></span></p>
        </div>
      </aside>

      <!-- Formulaire -->
      <div class="formulaire">
        {site.paiement === 'test' && (site.stripePublique.startsWith('pk_test_')
          ? <p class="mode-test">Mode test · aucun vrai paiement · carte 4242 4242 4242 4242</p>
          : <p class="mode-test">Accès réservé · achats pas encore ouverts au public · paiement réel</p>)}

        <div id="paiement" data-piece={d.sanity_id ?? oeuvre.id} data-retour={fiche} data-cle={site.stripePublique}>

          <form class="etapes" data-formulaire novalidate>
            <section class="express" data-express hidden aria-label="Paiement express">
              <p class="etiquette">Paiement express</p>
              <div id="express"></div>
              <p class="separateur"><span>ou</span></p>
            </section>

            <section class="etape" aria-labelledby="t-contact">
              <h2 id="t-contact"><span class="num">1</span>Coordonnées</h2>
              <label class="champ">
                <span>E-mail</span>
                <input type="email" name="email" autocomplete="email" inputmode="email" required placeholder="vous@exemple.fr" data-email />
              </label>
              <label class="champ">
                <span>Téléphone <small>pour le transporteur</small></span>
                <input type="tel" name="tel" autocomplete="tel" inputmode="tel" required placeholder="06 12 34 56 78" data-tel />
              </label>
            </section>

            <section class="etape" aria-labelledby="t-livraison">
              <h2 id="t-livraison"><span class="num">2</span>Livraison</h2>
              <div id="adresse" class="attente-stripe" style="--h:250px"></div>
              <p class="envoi" data-envoi><span data-envoi-nom>Colissimo, France métropolitaine et Monaco</span><strong data-envoi-prix>Offerte</strong></p>
              <p class="note">Outre-mer et hors d’Europe : <a href="/contact">écrivez-nous</a>, nous établissons un devis.</p>
            </section>

            <section class="etape" aria-labelledby="t-paiement">
              <h2 id="t-paiement"><span class="num">3</span>Paiement</h2>
              <div id="moyens" class="attente-stripe" style="--h:190px"></div>
              <p class="note" data-alma hidden>Alma : payez en 2, 3 ou 4 fois sans intérêts, après acceptation par Alma.</p>
            </section>

            <p class="message" role="alert" data-message hidden></p>
            <button type="submit" class="payer" data-payer disabled>
              <span data-payer-texte>Payer {prix(d.prix)}</span>
            </button>
            <ul class="garanties">
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Paiement sécurisé par Stripe</li>
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>Emballée à la main, expédiée sous 3 à 5 jours</li>
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l3 3v15H6z"/><path d="M9 10h6M9 14h6M9 18h4"/></svg>Facture et certificat d’authenticité</li>
            </ul>
            <p class="cgv">En payant, vous acceptez les <a href="/cgv">conditions de vente</a>. Droit de rétractation de 14 jours.</p>
          </form>
        </div>

        <div class="erreur" data-erreur hidden>
          <h2 data-erreur-titre></h2>
          <p data-erreur-texte></p>
          <a class="lien" data-erreur-lien href={fiche}>Revenir</a>
        </div>
        <noscript><p class="note">Le paiement intégré a besoin de JavaScript. <a href={`/api/acheter?piece=${d.sanity_id}&retour=${fiche}`}>Payer sur la page sécurisée Stripe</a>.</p></noscript>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="https://js.stripe.com/clover/stripe.js"></script>
<script>
  const zone = document.getElementById('paiement') as HTMLElement;
  const { piece, retour, cle } = zone.dataset as { piece: string; retour: string; cle: string };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
  const memo = `adelem-reservation-${piece}`;
  const FRANCE = ['FR', 'MC'];

  const erreur = (e: { titre: string; texte: string; retour?: string }) => {
    zone.hidden = true;
    const bloc = $('[data-erreur]');
    bloc.querySelector('[data-erreur-titre]')!.textContent = e.titre;
    bloc.querySelector('[data-erreur-texte]')!.textContent = e.texte;
    if (e.retour) bloc.querySelector<HTMLAnchorElement>('[data-erreur-lien]')!.href = e.retour;
    bloc.hidden = false;
  };
  const message = (t: string | null) => { const m = $('[data-message]'); m.textContent = t ?? ''; m.hidden = !t; };

  // Récapitulatif repliable (téléphone).
  $('[data-recap]').addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const ouvert = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(ouvert));
    $('.recap').classList.toggle('ouvert', ouvert);
    $('[data-recap-libelle]').textContent = ouvert ? 'Masquer le détail' : 'Voir le détail';
  });

  // Compte à rebours de la réservation.
  const reservation = (jusqua: string) => {
    const resa = $('[data-reservation]');
    const fin = Date.parse(jusqua);
    resa.querySelector('[data-heure]')!.textContent = new Date(fin).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' }).replace(':', ' h ');
    const reste = resa.querySelector<HTMLElement>('[data-reste]')!;
    const maj = () => {
      const min = Math.min(30, Math.ceil((fin - Date.now()) / 60000)); // 31 min côté Stripe (minimum imposé), 30 annoncées
      if (min <= 0) {
        resa.classList.add('expiree');
        resa.querySelector('p')!.innerHTML = '<strong>Réservation terminée</strong> · rechargez la page pour la réserver de nouveau, si elle est toujours disponible.';
        return clearInterval(minuteur);
      }
      reste.textContent = `${min} min`;
    };
    const minuteur = setInterval(maj, 15000);
    maj();
    resa.hidden = false;
  };

  (async () => {
    try {
      // Aperçu de mise en page uniquement : #cs=<secret>&pk=<clé> évite de créer une vraie session (et de réserver la pièce).
      const apercu = new URLSearchParams(location.hash.slice(1));
      const cleStripe = apercu.get('pk') ?? cle;
      // Réponse du serveur (réservation + session), déjà demandée en haut de page.
      const reponse: Promise<any> = apercu.get('cs')
        ? Promise.resolve({ clientSecret: apercu.get('cs') })
        : Promise.resolve((window as any).__adelemResa).then(async (j) => {
            if (j) return j;
            let jeton: string | null = null;
            try { jeton = localStorage.getItem(memo); } catch {}
            const r = await fetch('/api/acheter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ piece, retour, jeton }) });
            return r.json();
          });
      // Stripe commence à charger ses composants sans attendre la réponse (le secret lui est passé en promesse).
      const secret = reponse.then((j) => { if (j.erreur || !j.clientSecret) throw new Error('session indisponible'); return j.clientSecret as string; });
      secret.catch(() => {});

      // @ts-ignore Stripe.js chargé depuis js.stripe.com
      const stripe = window.Stripe(cleStripe);
      const css = getComputedStyle(document.documentElement);
      const v = (n: string) => css.getPropertyValue(n).trim();
      const checkout = stripe.initCheckoutElementsSdk({
        clientSecret: secret,
        elementsOptions: {
          fonts: [{ cssSrc: 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500&display=swap' }],
          appearance: {
            theme: 'night',
            variables: {
              fontFamily: '"IBM Plex Sans", system-ui, sans-serif', fontWeightNormal: '300', fontSizeBase: '15px',
              colorPrimary: v('--or'), colorBackground: '#232B23', colorText: v('--encre'), colorTextSecondary: v('--discret'),
              colorTextPlaceholder: '#7E857B', colorDanger: '#E59A8A', borderRadius: '2px', spacingUnit: '4px', gridRowSpacing: '14px',
            },
            rules: {
              '.Input': { border: `1px solid ${v('--trait')}`, boxShadow: 'none', padding: '13px 14px' },
              '.Input:focus': { border: `1px solid ${v('--or')}`, boxShadow: 'none' },
              '.Label': { fontSize: '12px', letterSpacing: '0.04em', color: v('--texte') },
              '.AccordionItem': { border: `1px solid ${v('--trait')}`, boxShadow: 'none', backgroundColor: '#1F261F' },
              '.AccordionItem--selected': { border: `1px solid ${v('--or')}` },
            },
          },
        },
      });

      const j = await reponse;
      if (j.erreur) return erreur(j.erreur);
      if (!apercu.get('cs')) {
        try { localStorage.setItem(memo, j.jeton); } catch {}
        if (j.jusqua) reservation(j.jusqua);
        // Phrase sous Alma, seulement s'il est proposé (activé dans Stripe) et pour 50 € au moins (minimum d'Alma).
        if (Array.isArray(j.moyens) && j.moyens.includes('alma') && (j.montant ?? 0) >= 50) $('[data-alma]').hidden = false;
      }

      const form = $<HTMLFormElement>('[data-formulaire]');
      const payer = $<HTMLButtonElement>('[data-payer]');
      const { actions } = await checkout.loadActions();
      const euros = (s: any) => s.total.total.amount as string;

      // Totaux, libellé du bouton et ligne de livraison, recalculés à chaque changement de la session.
      const afficher = (s: any) => {
        $$('[data-total]').forEach((e) => (e.textContent = euros(s)));
        $('[data-sous-total]').textContent = s.total.subtotal.amount;
        const opt = s.shipping?.shippingOption;
        const gratuit = !opt || opt.minorUnitsAmount === 0;
        $('[data-livraison]').textContent = gratuit ? 'Offerte' : opt.amount;
        $('[data-envoi-prix]').textContent = gratuit ? 'Offerte' : opt.amount;
        const france = !opt || /France/.test(opt.displayName);
        $('[data-livraison-nom]').textContent = france ? 'Colissimo, France' : 'Colissimo, Europe';
        $('[data-envoi-nom]').textContent = france ? 'Colissimo, France métropolitaine et Monaco' : 'Colissimo, Europe';
        $('[data-payer-texte]').textContent = `Payer ${euros(s)}`;
      };
      afficher(actions.getSession());
      checkout.on('change', afficher);

      // Paiement express : Apple Pay, Google Pay, PayPal en tête (Link et Amazon Pay masqués).
      // On attend sa réponse avant de créer le formulaire de carte : un portefeuille affiché en express n'est pas
      // répété dans la liste ; s'il n'y est pas (navigateur, domaine…), il reste proposé dans la liste (2026-11-21).
      const express = checkout.createExpressCheckoutElement({
        buttonHeight: 48,
        buttonTheme: { applePay: 'white', googlePay: 'white', paypal: 'white' },
        layout: { maxColumns: 2, maxRows: 2, overflow: 'never' },
        // « always » : bouton visible même sans carte enregistrée dans le portefeuille (Google/Apple proposent alors d'en ajouter) ; 2026-11-21.
        paymentMethods: { applePay: 'always', googlePay: 'always', paypal: 'auto', link: 'never', amazonPay: 'never', klarna: 'never' },
      });
      const dispoExpress = new Promise<Record<string, boolean> | null>((ok) => {
        // Sans aucun portefeuille disponible, Stripe ne fournit pas la liste : on considère alors qu'il n'y en a aucun.
        express.on('ready', (e: any) => { console.info('[paiement] express prêt', e?.availablePaymentMethods); ok(e?.availablePaymentMethods ?? {}); });
        express.on('loaderror', (e: any) => { console.warn('[paiement] express indisponible', e?.error); ok({}); });
        setTimeout(() => ok({}), 6000);
      });
      express.on('confirm', async (e: any) => {
        const r = await actions.confirm({ expressCheckoutConfirmEvent: e });
        if (r?.type === 'error') message(r.error.message);
      });
      express.mount('#express');

      // Adresse de livraison (suggestions automatiques) : le pays choisit seul le bon tarif d'envoi.
      const adresse = checkout.createShippingAddressElement();
      adresse.on('change', async (e: any) => {
        const pays = e?.value?.address?.country;
        if (!pays) return;
        const s = actions.getSession();
        const voulu = s.shippingOptions.find((o: any) => (FRANCE.includes(pays) ? /France/ : /Europe/).test(o.displayName));
        if (voulu && s.shipping?.shippingOption?.id !== voulu.id) await actions.updateShippingOption(voulu.id);
      });
      adresse.on('ready', () => $('#adresse').classList.remove('attente-stripe'));
      adresse.mount('#adresse');

      // Carte bancaire et Alma (2, 3 ou 4 fois), plus les portefeuilles absents du paiement express.
      const disposition = { type: 'accordion', defaultCollapsed: false, radios: true, spacedAccordionItems: true };
      const moyens = checkout.createPaymentElement({ layout: disposition });
      dispoExpress.then((dispo) => {
        const montres = Object.entries(dispo ?? {}).filter(([, v]) => v).map(([k]) => k);
        $('[data-express]').hidden = montres.length === 0;
        if (!montres.length) return;
        try { moyens.update({ wallets: { applePay: montres.includes('applePay') ? 'never' : 'auto', googlePay: montres.includes('googlePay') ? 'never' : 'auto' } }); }
        catch (e) { console.warn('[paiement] doublon portefeuille non retiré', e); }
      });
      moyens.on('ready', () => { $('#moyens').classList.remove('attente-stripe'); payer.disabled = false; });
      moyens.mount('#moyens');

      // E-mail et téléphone : transmis à Stripe dès qu'ils sont saisis.
      const email = $<HTMLInputElement>('[data-email]');
      const tel = $<HTMLInputElement>('[data-tel]');
      const envoyerEmail = async () => { if (!email.value) return true; const r = await actions.updateEmail(email.value.trim()); email.toggleAttribute('aria-invalid', r?.type === 'error'); return r?.type !== 'error'; };
      const envoyerTel = async () => { if (!tel.value) return true; const r = await actions.updatePhoneNumber(tel.value.trim()); tel.toggleAttribute('aria-invalid', r?.type === 'error'); return r?.type !== 'error'; };
      email.addEventListener('change', envoyerEmail);
      tel.addEventListener('change', envoyerTel);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        message(null);
        if (!email.value || !email.checkValidity()) { email.focus(); return message('Indiquez une adresse e-mail valide pour recevoir la facture.'); }
        if (!tel.value) { tel.focus(); return message('Indiquez un numéro de téléphone pour le transporteur.'); }
        payer.disabled = true;
        payer.classList.add('en-cours');
        try {
          if (!(await envoyerEmail())) throw new Error('Adresse e-mail non reconnue.');
          if (!(await envoyerTel())) throw new Error('Numéro de téléphone non reconnu.');
          const r = await actions.confirm();
          if (r?.type === 'error') throw new Error(r.error.message);
        } catch (err) {
          message((err as Error).message || 'Le paiement n’a pas abouti. Vérifiez vos informations et réessayez.');
          payer.disabled = false;
          payer.classList.remove('en-cours');
        }
      });

    } catch (e) {
      console.error(e);
      erreur({ titre: 'Paiement momentanément indisponible', texte: 'La page de paiement n’a pas pu s’ouvrir. Réessayez dans un instant, ou écrivez-nous depuis la page Contact.', retour: '/contact' });
    }
  })();
</script>

<style>
  .caisse { padding-top: clamp(20px, 3vw, 40px); padding-bottom: clamp(48px, 6vw, 96px); }
  .retour { display: inline-flex; gap: 8px; margin-bottom: clamp(18px, 3vw, 32px); color: var(--or); font: 400 .74rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .retour:hover { color: var(--encre); }
  .grille { display: grid; gap: clamp(24px, 5vw, 88px); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 960px) { .grille { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); } }

  /* ---- Récapitulatif ---- */
  .recap { display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 960px) { .recap { position: sticky; top: 24px; } }
  .recap-bandeau { display: none; }
  .recap-photo { margin: 0 0 12px; display: flex; justify-content: center; }
  .recap-photo img {
    width: min(100%, max(240px, calc(var(--l) * 8px))); max-height: 40vh; height: auto; object-fit: contain;
    filter: drop-shadow(0 22px 30px rgba(0, 0, 0, .6)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
  }
  .surtitre { font: 400 .7rem var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--or); }
  .recap h1 { font-size: clamp(2.2rem, 3.6vw, 3rem); line-height: 1.05; margin-top: 6px; }
  .sous-titre { font: italic 300 1.2rem/1.3 var(--serif); color: var(--encre); margin-top: 4px; }
  .cartel { font-size: .88rem; color: var(--discret); margin-top: 8px; }
  .lignes { margin: 20px 0 0; display: grid; gap: 10px; border-top: 1px solid var(--trait); padding-top: 18px; font-size: .92rem; }
  .lignes div { display: flex; justify-content: space-between; gap: 16px; }
  .lignes dt span { color: var(--discret); font-size: .82rem; margin-left: 6px; }
  .lignes dd { margin: 0; color: var(--encre); font-variant-numeric: lining-nums tabular-nums; }
  .ligne-total { border-top: 1px solid var(--trait); padding-top: 14px; margin-top: 4px; align-items: baseline; }
  .ligne-total dt { font: 400 1rem var(--sans); color: var(--encre); }
  .ligne-total dd { font: 400 1.9rem var(--serif); }
  .reservation { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid rgba(201, 175, 120, .45); background: rgba(201, 175, 120, .06); font-size: .86rem; }
  .reservation[hidden] { display: none; }
  .reservation p { margin: 0; color: var(--texte); }
  .reservation strong { color: var(--or); font-weight: 500; }
  .point { width: 8px; height: 8px; border-radius: 50%; background: var(--or); flex: none; animation: pouls 2s ease-in-out infinite; }
  @keyframes pouls { 50% { opacity: .35; transform: scale(.8); } }
  .reservation.expiree { border-color: var(--trait); background: none; }
  .reservation.expiree .point { animation: none; background: var(--discret); }
  .reservation.expiree strong { color: var(--discret); }

  /* ---- Formulaire ---- */
  .formulaire { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .mode-test { font: 500 .64rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--or); }
  .etapes { display: flex; flex-direction: column; gap: 30px; }
  .etapes[hidden] { display: none; }
