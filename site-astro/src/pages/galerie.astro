---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mur from '../components/Mur.astro';
import { site } from '../data/site';

const toutes = (await getCollection('oeuvres')).sort((a, b) => a.data.ordre - b.data.ordre);
const formats = [
  { nom: 'Grand format', ligne: 'Une présence architecturale' },
  { nom: 'Format signature', ligne: 'Le point focal d’une pièce' },
  { nom: 'Petit format', ligne: 'Une présence discrète' },
] as const;
const salle = site.salle === 'sombre';
const vendues = toutes.filter((o) => o.data.statut === 'vendue');
---
<Base title="Œuvres" description="Tableaux végétaux disponibles, présentés à leur échelle réelle, et œuvres entrées en collection privée." salle={salle}>
  <div class:list={['salle-page', { salle }]}>
    <div class="wrap entete-page">
      <h1>Œuvres</h1>
      <p class="discret">Présentées à leur échelle réelle les unes par rapport aux autres.</p>
    </div>
    {formats.map(({ nom, ligne }, i) => {
      const items = toutes.filter((o) => o.data.format === nom && o.data.statut !== 'vendue');
      // Seul le tout premier groupe affiché est au-dessus de la ligne de flottaison.
      const premierGroupe = i === formats.findIndex((f2) => toutes.some((o) => o.data.format === f2.nom && o.data.statut !== 'vendue'));
      return items.length > 0 && (
        <section class="wrap groupe">
          <h2>{nom}</h2>
          <p class="discret ligne-format">{ligne}</p>
          <Mur oeuvres={items} salle={salle} eager={premierGroupe} />
        </section>
      );
    })}
  </div>
  {vendues.length > 0 && (
    <section class="wrap bloc">
      <h2 class="titre-section">En collection privée</h2>
      <Mur oeuvres={vendues} />
    </section>
  )}
  <section class="wrap bloc centre">
    <p class="texte">Un mur ou un cadre qui demande une taille précise ?</p>
    <a class="lien" href="/sur-mesure">Le sur-mesure</a>
  </section>
</Base>

<style>
  .salle-page { padding-top: clamp(40px, 6vw, 72px); }
  .salle-page.salle { background: var(--salle); padding-bottom: 40px; }
  .entete-page { text-align: center; margin-bottom: 64px; display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .entete-page h1 { font-size: clamp(2.6rem, 5vw, 3.6rem); }
  .salle h1, .salle h2 { color: var(--salle-texte); }
  .salle .discret { color: var(--salle-discret); }
  .groupe h2 { font: italic 300 1.6rem var(--serif); text-align: center; margin-bottom: 6px; }
  .groupe + .groupe { margin-top: 40px; }
  .ligne-format { text-align: center; margin-bottom: 36px; }
  .centre { text-align: center; }
  .centre .texte { margin-inline: auto; margin-bottom: 16px; }
</style>
