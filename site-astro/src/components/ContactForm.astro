---
import { site } from '../data/site';

interface Props { oeuvre?: string }
const { oeuvre } = Astro.props;
const endpoint = site.formEndpoint;
const email = site.contact.email;
const fichiersActifs = site.formFileUploads;
---
{endpoint ? (
  <form class="formulaire" method="post" action={endpoint} enctype="multipart/form-data" data-secours={email ?? ''}>
    <input type="hidden" name="_subject" value={oeuvre ? `Demande : ${oeuvre}` : 'Nouvelle demande depuis adelem.fr'} />
    <input type="hidden" name="_next" value={`${site.url}/merci`} />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
    {oeuvre && <input type="hidden" name="oeuvre" value={oeuvre} />}
    <div class="deux">
      <label>Nom<input name="nom" autocomplete="name" required /></label>
      <label>E-mail<input name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" required /></label>
    </div>
    <label>Téléphone (facultatif)<input name="telephone" type="tel" autocomplete="tel" /></label>
    <label>Message<textarea name="message" rows="4" maxlength="4000" required>{oeuvre ? `Bonjour, à propos de ${oeuvre} :` : ''}</textarea></label>
    {fichiersActifs && (
      <label>Photo de votre mur (facultatif)<input name="photo" type="file" accept="image/*" /></label>
    )}
    <label class="case">
      <input type="checkbox" name="newsletter" value="oui" />
      <span>Je veux bien recevoir, de temps en temps, des nouvelles de l’atelier et des nouvelles pièces</span>
    </label>
    <p class="discret">Vos coordonnées servent uniquement à répondre. Réponse sous {site.delaiReponse}.</p>
    <div class="pied">
      <button class="bouton" type="submit">Envoyer</button>
      <p class="statut" role="status" aria-live="polite" tabindex="-1" hidden></p>
    </div>
  </form>
) : email ? (
  <p><a class="lien" href={`mailto:${email}?subject=${encodeURIComponent(oeuvre ? `Demande : ${oeuvre}` : 'Demande depuis adelem.fr')}`}>Écrire à l’atelier</a></p>
) : (
  <p class="discret attente">Le formulaire sera actif à la mise en ligne.</p>
)}

<style>
  .formulaire { display: grid; gap: 26px; max-width: 620px; width: 100%; }
  .deux { display: grid; gap: 26px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  label { display: grid; gap: 6px; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--texte); }
  input, textarea { font: 400 1rem/1.5 var(--sans); color: var(--encre); background: transparent; border: 0; border-bottom: 1px solid rgba(236, 233, 224, .3); padding: 8px 0; border-radius: 0; width: 100%; text-transform: none; letter-spacing: 0; }
  input:focus, textarea:focus { border-bottom-color: var(--or); }
  input:user-invalid, textarea:user-invalid { border-bottom-color: #D98B72; }
  input[type='file'] { border: 0; font-size: .85rem; }
  .case { display: flex; align-items: flex-start; gap: 10px; font: 400 .85rem/1.45 var(--sans); letter-spacing: 0; text-transform: none; color: var(--texte); cursor: pointer; }
  .case input { width: auto; flex: none; margin-top: 3px; accent-color: var(--or); }
  .pied { display: grid; gap: 12px; justify-items: start; }
  button { justify-self: start; transition: opacity .2s ease; }
  button:disabled { opacity: .55; cursor: wait; }
  .statut { font-size: .85rem; color: var(--texte); }
  .statut.erreur { color: #D98B72; }
  .attente { padding: 20px 0; border-top: 1px solid var(--trait); }
</style>

<script>
  // Amélioration progressive : sans JS, le formulaire fonctionne déjà nativement
  // (POST classique vers Formspree + redirection _next vers /merci).
  // Avec JS, on intercepte pour éviter les doubles envois et afficher une
  // erreur claire dans la page plutôt qu'une page d'erreur générique de Formspree.
  document.querySelectorAll<HTMLFormElement>('form.formulaire').forEach((form) => {
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const statut = form.querySelector<HTMLElement>('.statut');
    const libelleInitial = bouton?.textContent ?? 'Envoyer';
    const secours = form.dataset.secours;

    form.addEventListener('submit', async (evenement) => {
      // Un piège à robots rempli : on laisse Formspree traiter (et rejeter) normalement.
      const piege = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
      if (piege && piege.value) return;

      evenement.preventDefault();
      if (bouton) { bouton.disabled = true; bouton.textContent = 'Envoi…'; }
      if (statut) { statut.hidden = true; statut.classList.remove('erreur'); statut.textContent = ''; }

      try {
        const reponse = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
        const suite = form.querySelector<HTMLInputElement>('input[name="_next"]')?.value || '/merci';
        window.location.href = suite;
      } catch {
        if (bouton) { bouton.disabled = false; bouton.textContent = libelleInitial; }
        if (statut) {
          statut.hidden = false;
          statut.classList.add('erreur');
          statut.textContent = secours
            ? `Le message n’a pas pu être envoyé. Réessayez, ou écrivez directement à ${secours}.`
            : 'Le message n’a pas pu être envoyé. Réessayez dans quelques instants.';
          statut.focus();
        }
      }
    });
  });
</script>
