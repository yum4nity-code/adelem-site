---
import { resume } from '../data/site';
// Une page de la galerie qui montre des œuvres : fil d'Ariane, titre, texte éventuel, pièces disponibles,
// puis pièces vendues de la même rubrique.
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mur from './Mur.astro';

interface Props {
  titre: string;
  fil: { nom: string; href: string }[];
  oeuvres: CollectionEntry<'oeuvres'>[];
  texte?: string | null;
  echelleLocale?: boolean;
}
const { titre, fil, oeuvres, texte = null, echelleLocale = false } = Astro.props;
const tri = [...oeuvres].sort((a, b) => a.data.ordre - b.data.ordre);
const dispo = tri.filter((o) => o.data.statut !== 'vendue');
const vendues = tri.filter((o) => o.data.statut === 'vendue');
---
<Base title={titre} description={resume(texte ?? `${titre} : pièces uniques Adelem, faites main en France. Livraison offerte en France.`)}>
  <div class="salle-page">
    <div class="wrap entete-page">
      <nav class="discret fil" aria-label="Fil d’Ariane">{fil.map((f, i) => <>{i > 0 && ' / '}<a href={f.href}>{f.nom}</a></>)}</nav>
      <h1 class="titre-page">{titre}</h1>
      {texte && <p class="texte-rubrique">{texte}</p>}
    </div>
    <div class="wrap">
      {dispo.length > 0 && <Mur oeuvres={dispo} eager echelleLocale={echelleLocale} />}
      {/* « Bientôt » seulement si la rubrique n'a aucune pièce du tout (une pièce vendue compte : elle s'affiche plus bas). */}
      {dispo.length === 0 && vendues.length === 0 && <p class="discret a-venir">Les pièces arrivent bientôt.</p>}
    </div>
  </div>
  {vendues.length > 0 && (
    <section class:list={['wrap', 'privee', { bloc: dispo.length > 0 }]}>
      <h2 class="titre-section">En collection privée</h2>
      {dispo.length === 0 && <p class="discret a-venir">Ces pièces ont trouvé leur place. Les prochaines arrivent bientôt.</p>}
      <Mur oeuvres={vendues} eager={dispo.length === 0} echelleLocale={echelleLocale} />
    </section>
  )}
</Base>

<style>
  .salle-page { padding-top: clamp(40px, 6vw, 72px); }
  .entete-page { text-align: center; margin-bottom: 64px; display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .fil a:hover { color: var(--encre); }
  .texte-rubrique { max-width: 62ch; margin: 8px auto 0; color: var(--texte); line-height: 1.7; white-space: pre-line; }
  .a-venir { text-align: center; }
  .privee .titre-section { text-align: center; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 12px; }
  .privee .a-venir { margin-bottom: 48px; }
  .privee > :global(.mur) { margin-top: 48px; }
</style>
