---
import type { CollectionEntry } from 'astro:content';
import Cartel from './Cartel.astro';

// Accrochage à l'échelle : chaque œuvre a la largeur réelle de son cadre (var(--cm) px par cm),
// et tous les centres sont alignés sur une même ligne, comme dans un musée.
// echelleLocale : pour les murs de sculptures uniquement. Les murs de tableaux gardent l'échelle commune (--cm global),
// pour que les tailles restent comparables d'un format à l'autre.
interface Props { oeuvres: CollectionEntry<'oeuvres'>[]; eager?: boolean; echelleLocale?: boolean }
const { oeuvres, eager = false, echelleLocale = false } = Astro.props;
// Échelle propre à chaque mur, pour qu'un mur d'une seule petite pièce (une sculpture, par exemple) ne paraisse pas
// minuscule : la plus grande pièce du mur remplit la largeur utile sur mobile, et la plus haute atteint au moins
// 330 px (la hauteur d'un grand tableau à 5,5 px/cm) sur grand écran. Les proportions entre pièces d'un même mur restent justes.
const reference = Math.max(30, ...oeuvres.map((o) => Math.max(o.data.largeur_cm * 1.05, o.data.hauteur_cm * 0.75)));
const plafond = Math.max(5.5, 330 / Math.max(...oeuvres.map((o) => o.data.hauteur_cm))).toFixed(2);
---
<div class="mur" role="list" style={echelleLocale ? `--cm: min(${plafond}px, calc((100vw - 48px) / ${Math.round(reference)}))` : undefined}>
  {oeuvres.map((o, i) => (
    <a role="listitem" href={`/oeuvres/${o.id}`} class="piece" style={`--l:${o.data.largeur_cm};--h:${o.data.hauteur_cm}`}>
      <img
        src={o.data.photos[0].src}
        alt={o.data.photos[0].alt}
        width={Math.round(o.data.largeur_cm * 10)}
        height={Math.round(o.data.hauteur_cm * 10)}
        loading={eager && i < 3 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="voir" aria-hidden="true">Voir l’œuvre</span>
      <div class="sous"><Cartel oeuvre={o} /></div>
    </a>
  ))}
</div>

<style>
  .mur {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    column-gap: calc(var(--cm) * 26); row-gap: 150px; padding-bottom: 120px;
  }
  .piece { position: relative; display: block; width: calc(var(--cm) * var(--l)); }
  .piece img {
    width: 100%; height: auto; aspect-ratio: var(--l) / var(--h); object-fit: cover;
    filter: drop-shadow(0 calc(var(--cm) * 3) calc(var(--cm) * 5) rgba(0, 0, 0, .6)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
    transition: transform .6s cubic-bezier(.16, 1, .3, 1), filter .6s cubic-bezier(.16, 1, .3, 1);
  }
  .piece:focus-visible img {
    transform: translateY(-6px) scale(1.015);
    filter: drop-shadow(0 calc(var(--cm) * 5) calc(var(--cm) * 8) rgba(0, 0, 0, .68)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
  }
  /* Appel discret au clic, révélé au survol : une pièce d'art ne « vend » pas, mais elle peut inviter. */
  .voir {
    position: absolute; inset: auto 0 0 0; padding: 20px calc(var(--cm) * 2) 12px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .5));
    font: 500 .68rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--encre);
    opacity: 0; transform: translateY(6px); transition: opacity .45s ease, transform .45s cubic-bezier(.16, 1, .3, 1);
    pointer-events: none;
  }
  .piece:focus-visible .voir { opacity: 1; transform: none; }
  .sous { position: absolute; top: calc(100% + 22px); left: 0; width: max(100%, 190px); }
  .piece:focus-visible :global(.titre) { color: var(--or); }
  :global(.titre) { transition: color .4s ease; }

  /* Le survol n'existe que sur un vrai pointeur : sur tactile, un :hover classique reste
     « collé » après un tap tant qu'on ne touche pas ailleurs. Le clavier garde son focus plus haut. */
  @media (hover: hover) and (pointer: fine) {
    .piece:hover img {
      transform: translateY(-6px) scale(1.015);
      filter: drop-shadow(0 calc(var(--cm) * 5) calc(var(--cm) * 8) rgba(0, 0, 0, .68)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
    }
    .piece:hover .voir { opacity: 1; transform: none; }
    .piece:hover :global(.titre) { color: var(--or); }
  }
</style>
