---
import type { CollectionEntry } from 'astro:content';
import Cartel from './Cartel.astro';

// Accrochage : chaque œuvre a une largeur liée à celle de son cadre (var(--cm) px par cm, échelle adoucie, voir plus bas),
// et tous les centres sont alignés sur une même ligne, comme dans un musée.
// echelleLocale : pour les murs de sculptures uniquement. Les murs de tableaux gardent l'échelle commune (--cm global),
// pour que les tailles restent comparables d'un format à l'autre.
interface Props { oeuvres: CollectionEntry<'oeuvres'>[]; eager?: boolean; echelleLocale?: boolean }
const { oeuvres, eager = false, echelleLocale = false } = Astro.props;
// Échelle propre à chaque mur, pour qu'un mur d'une seule petite pièce (une sculpture, par exemple) ne paraisse pas
// minuscule : la plus grande pièce du mur remplit la largeur utile sur mobile, et la plus haute atteint au moins
// 330 px (la hauteur d'un grand tableau à 5,5 px/cm) sur grand écran. Les proportions entre pièces d'un même mur restent justes.
const reference = Math.max(30, ...oeuvres.map((o) => Math.max(o.data.largeur_cm * 1.05, o.data.hauteur_cm * 0.75)));
const plafond = Math.max(5.5, 330 / Math.max(...oeuvres.map((o) => o.data.hauteur_cm))).toFixed(2);
// Murs de tableaux : échelle « adoucie » (décisions des 2026-10-25 et 2026-10-26, demandes d'Adèle). Les petits formats
// (21 × 29 cm) étaient presque invisibles à l'échelle réelle. La taille suit le PLUS GRAND CÔTÉ du cadre, à la puissance 0,35 :
// un petit tableau reste bien visible, mais plus petit qu'un grand dans les deux sens, même s'il est en hauteur et l'autre
// en largeur (avant, avec un minimum commun de 72 % de l'écran sur téléphone, un 21 × 29 paraissait plus grand qu'un 62 × 49).
// La même règle sert sur ordinateur et sur téléphone (--cm suit la largeur de l'écran). Un cadre de 95 cm ou plus garde l'échelle réelle.
const REF = 95;
const largeurAffichee = (l: number, h: number) => {
  if (echelleLocale) return l;
  const m = Math.max(l, h);
  return m >= REF ? l : REF * Math.pow(m / REF, 0.35) * (l / m);
};
---
<div class:list={['mur', { locale: echelleLocale }]} role="list" style={echelleLocale ? `--cm: min(${plafond}px, calc((100vw - 48px) / ${Math.round(reference)}))` : undefined}>
  {oeuvres.map((o, i) => (
    <a role="listitem" href={`/oeuvres/${o.id}`} class="piece" style={`--l:${largeurAffichee(o.data.largeur_cm, o.data.hauteur_cm).toFixed(2)};--r:${o.data.largeur_cm} / ${o.data.hauteur_cm}`}>
      <img
        src={o.data.photos[0].src}
        alt={o.data.photos[0].alt}
        width={Math.round(o.data.largeur_cm * 10)}
        height={Math.round(o.data.hauteur_cm * 10)}
        loading={eager && i < 3 ? 'eager' : 'lazy'}
        decoding="async"
      />
      {o.data.statut === 'vendue' && <span class="pastille-vendue" aria-hidden="true">Collection privée</span>}
      <span class="voir" aria-hidden="true">Voir l’œuvre</span>
      <div class="sous"><Cartel oeuvre={o} /></div>
    </a>
  ))}
</div>

<script>
  // Les cartels sont hors du flux (pour que les centres des œuvres restent alignés) : la place sous chaque rangée
  // est donc calculée ici, d'après le cartel le plus haut de la rangée. Sans JavaScript, les marges fixes du CSS servent.
  const caler = () => {
    document.querySelectorAll<HTMLElement>('.mur').forEach((mur) => {
      const pieces = [...mur.querySelectorAll<HTMLElement>(':scope > .piece')];
      pieces.forEach((p) => (p.style.marginBottom = '0px'));
      mur.classList.add('cale');
      // Rangées : une nouvelle commence quand une pièce revient à gauche de la précédente (retour à la ligne du flex).
      const rangees: HTMLElement[][] = [];
      let gauche = -Infinity;
      for (const p of pieces) {
        if (p.offsetLeft <= gauche || !rangees.length) rangees.push([]);
        rangees[rangees.length - 1].push(p);
        gauche = p.offsetLeft;
      }
      for (const r of rangees) {
        const besoin = Math.max(...r.map((p) => p.querySelector<HTMLElement>('.sous')!.offsetHeight)) + 22 + 8;
        r.forEach((p) => (p.style.marginBottom = besoin + 'px'));
      }
    });
  };
  caler();
  // Les pièces « respirent » (2026-10-30, Gwen) : chacune apparaît en fondu quand on arrive dessus en faisant défiler,
  // et son ombre se pose derrière elle, comme si on l'accrochait au mur. Rien de caché sans JavaScript
  // ni avec « réduire les animations ».
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const vues = new IntersectionObserver((entrees) => {
      let rang = 0;
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        const p = e.target as HTMLElement;
        vues.unobserve(p);
        const delai = rang++ * 110;
        p.style.setProperty('--delai', delai + 'ms');
        p.classList.add('vue');
        setTimeout(() => p.classList.add('posee'), delai + 1300);
      }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll<HTMLElement>('.mur').forEach((mur) => {
      mur.classList.add('anim');
      mur.querySelectorAll<HTMLElement>(':scope > .piece').forEach((p) => vues.observe(p));
    });
  }
  let attente: number;
  addEventListener('resize', () => { clearTimeout(attente); attente = window.setTimeout(caler, 120); });
  addEventListener('load', caler);
  document.fonts?.ready.then(caler);
</script>

<style>
  .mur.cale { row-gap: 64px; padding-bottom: 0; }
  .mur {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    /* Les cartels sont posés sous chaque pièce, hors du flux : ces marges leur réservent la place
       (titre, matière, cadre, dimensions et prix, statut), y compris sur deux lignes. */
    column-gap: calc(var(--cm) * 26); row-gap: 200px; padding-bottom: 190px;
  }
  .piece { position: relative; display: block; width: calc(var(--cm) * var(--l)); }
  .piece img {
    width: 100%; height: auto; aspect-ratio: var(--r); object-fit: cover;
    filter: drop-shadow(0 calc(var(--cm) * 3) calc(var(--cm) * 5) rgba(0, 0, 0, .6)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
    transition: transform .6s cubic-bezier(.16, 1, .3, 1), filter .6s cubic-bezier(.16, 1, .3, 1);
  }
  /* Apparition au défilement (voir le script) : avant, l'œuvre est un peu plus bas, transparente et sans ombre. */
  .mur.anim .piece:not(.posee) img { transition: opacity .9s ease var(--delai, 0ms), transform 1.1s cubic-bezier(.16, 1, .3, 1) var(--delai, 0ms), filter 1.3s ease calc(var(--delai, 0ms) + .15s); }
  .mur.anim .piece:not(.vue) img { opacity: 0; transform: translateY(18px); filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)) drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
  .mur.anim .piece:not(.vue) .sous { opacity: 0; }
  .mur.anim .piece .sous { transition: opacity .9s ease calc(var(--delai, 0ms) + .25s); }
  /* Pièce vendue : petite étiquette posée en biais sur le coin, comme le macaron d'une galerie. */
  .pastille-vendue { position: absolute; top: -10px; right: -12px; z-index: 1; }
  .piece:focus-visible img {
    transform: translateY(-6px) scale(1.015);
    filter: drop-shadow(0 calc(var(--cm) * 5) calc(var(--cm) * 8) rgba(0, 0, 0, .68)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
  }
  /* Appel discret au clic, révélé au survol : une pièce d'art ne « vend » pas, mais elle peut inviter. */
  .voir {
    position: absolute; inset: auto 0 0 0; padding: 20px calc(var(--cm) * 2) 12px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .5));
    font: 500 .68rem/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--encre);
    opacity: 0; transform: translateY(6px); transition: opacity .45s ease, transform .45s cubic-bezier(.16, 1, .3, 1);
    pointer-events: none;
  }
  .piece:focus-visible .voir { opacity: 1; transform: none; }
  .sous { position: absolute; top: calc(100% + 22px); left: 0; width: max(100%, 190px); }
  /* Téléphone : une œuvre par rangée, cartel centré dessous. Les murs de sculptures (échelle locale) gardent un minimum
     de 72 % de la largeur (plafonné en hauteur) ; les tableaux suivent la règle du plus grand côté (voir largeurAffichee). */
  @media (max-width: 600px) {
    .piece { max-width: calc(100vw - 48px); }
    /* … sans dépasser 62 % de la hauteur de l'écran : une sculpture haute et étroite (largeur minimum de 72 %) devenait
       démesurée (2026-10-28). La largeur est ramenée à 62svh × (largeur / hauteur). */
    .mur.locale .piece { width: min(max(calc(var(--cm) * var(--l)), 72vw), calc(62svh * (var(--r)))); }
    .sous { left: 50%; transform: translateX(-50%); width: max(100%, 260px); }
    .sous :global(.cartel) { align-items: center; text-align: center; }
  }
  .piece:focus-visible :global(.titre) { color: var(--or); }
  :global(.titre) { transition: color .4s ease; }

  /* Le survol n'existe que sur un vrai pointeur : sur tactile, un :hover classique reste
     « collé » après un tap tant qu'on ne touche pas ailleurs. Le clavier garde son focus plus haut. */
  @media (hover: hover) and (pointer: fine) {
    .piece:hover img {
      transform: translateY(-6px) scale(1.015);
      filter: drop-shadow(0 calc(var(--cm) * 5) calc(var(--cm) * 8) rgba(0, 0, 0, .68)) drop-shadow(0 1px 2px rgba(0, 0, 0, .5));
    }
    .piece:hover .voir { opacity: 1; transform: none; }
    .piece:hover :global(.titre) { color: var(--or); }
  }
</style>
