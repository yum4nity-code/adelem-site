---
import { site } from '../data/site';

// Inscription « être prévenu des prochaines pièces », proposée quand une pièce est vendue ou épuisée,
// pour qu'une pièce partie continue d'ouvrir la relation au lieu d'être une impasse.
interface Props { piece?: string; reservee?: boolean }
const { piece, reservee = false } = Astro.props;
const endpoint = site.formEndpoint;
---
{endpoint && (
  <form class="prevenir" method="post" action={endpoint} data-prevenir>
    <input type="hidden" name="_subject" value={reservee && piece ? `Être prévenu si « ${piece} » se libère` : piece ? `Être prévenu des prochaines pièces (depuis ${piece})` : 'Être prévenu des prochaines pièces'} />
    <input type="hidden" name="newsletter" value="oui" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
    <label for="prevenir-email">{reservee ? 'Être prévenu si elle se libère' : 'Être prévenu des prochaines pièces'}</label>
    <div class="ligne">
      <input id="prevenir-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" required placeholder="Votre e-mail" />
      <button class="bouton" type="submit">Me prévenir</button>
    </div>
    <p class="statut-prevenir" role="status" tabindex="-1" hidden></p>
    <p class="discret">{reservee ? 'Un e-mail si elle se libère, puis de temps en temps quand une pièce sort de l’atelier.' : 'Un e-mail de temps en temps, quand une pièce sort de l’atelier.'} Désinscription sur simple demande.</p>
  </form>
)}

<script>
  // Envoi sans quitter la page (Formspree gratuit n'accepte pas de redirection personnalisée) : succès → /merci.
  document.querySelectorAll<HTMLFormElement>('form[data-prevenir]').forEach((form) => {
    const statut = form.querySelector<HTMLElement>('.statut-prevenir');
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      if (form.querySelector<HTMLInputElement>('input[name="_gotcha"]')?.value) return;
      e.preventDefault();
      if (bouton) bouton.disabled = true;
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        location.href = '/merci';
      } catch {
        if (bouton) bouton.disabled = false;
        if (statut) { statut.hidden = false; statut.textContent = 'L’inscription n’a pas pu être envoyée. Réessayez dans un instant.'; statut.focus(); }
      }
    });
  });
</script>

<style>
  .statut-prevenir { color: #D98B72; font-size: .85rem; margin: 0; }
  .prevenir { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 460px; }
  label { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--texte); }
  .ligne { display: flex; gap: 12px; align-items: stretch; flex-wrap: wrap; }
  input[type='email'] { flex: 1 1 220px; font: 400 1rem/1.5 var(--sans); color: var(--encre); background: transparent; border: 0; border-bottom: 1px solid rgba(236, 233, 224, .3); padding: 8px 0; border-radius: 0; }
  input[type='email']:focus { border-bottom-color: var(--or); }
  input::placeholder { color: var(--discret); }
</style>
