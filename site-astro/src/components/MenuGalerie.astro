---
// Une page de la galerie qui ne montre que des titres (les thèmes, ou les collections des végétaux stabilisés).
// Chaque titre est posé sur une photo (voir photoRubrique dans data/galerie.ts), assombrie pour rester lisible.
// Téléphone : la photo s'éclaire quand le titre arrive au milieu de l'écran. Ordinateur : au survol.
import Base from '../layouts/Base.astro';

interface Props {
  titre: string;
  fil?: { nom: string; href: string }[];
  liens: { nom: string; href: string; photo: { src: string; oeuvre: boolean } }[];
  description: string;
  texte?: string | null;
}
const { titre, fil = [], liens, description, texte = null } = Astro.props;
---
<Base title={titre} description={description}>
  <div class="wrap salle-page">
    {fil.length > 0 && <nav class="discret fil" aria-label="Fil d’Ariane">{fil.map((f, i) => <>{i > 0 && ' / '}<a href={f.href}>{f.nom}</a></>)}</nav>}
    <h1 class="titre-page">{titre}</h1>
    {texte && <p class="texte-rubrique">{texte}</p>}
    <ul class="choix">
      {liens.map((l, i) => (
        <li>
          <a href={l.href} class="tuile">
            <img src={l.photo.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" class:list={{ ambiance: !l.photo.oeuvre }} />
            <span>{l.nom}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<script>
  // Sur tactile (pas de survol), la tuile au milieu de l'écran s'éclaire.
  if (!matchMedia('(hover: hover) and (pointer: fine)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entrees) => entrees.forEach((e) => e.target.classList.toggle('vue', e.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px' },
    );
    document.querySelectorAll('.tuile').forEach((t) => io.observe(t));
  }
</script>

<style>
  .salle-page { padding-top: clamp(40px, 6vw, 72px); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .fil a:hover { color: var(--encre); }
  .texte-rubrique { max-width: 62ch; margin: 8px auto 0; color: var(--texte); line-height: 1.7; white-space: pre-line; }
  .choix { list-style: none; margin: clamp(40px, 6vw, 72px) 0 0; padding: 0; width: min(100%, 980px); display: flex; flex-direction: column; gap: clamp(16px, 2.4vw, 28px); }
  .tuile { position: relative; display: grid; place-items: center; overflow: hidden; height: clamp(170px, 30vw, 280px); border-radius: 2px; isolation: isolate; background: #121612; }
  .tuile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; opacity: .55; transform: scale(1.06); filter: saturate(.85); transition: opacity .9s ease, transform 1.4s cubic-bezier(.16, 1, .3, 1), filter .9s ease; }
  /* Voile sombre pour que le titre reste lisible sur n'importe quelle photo. */
  .tuile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at center, rgba(10, 13, 10, .55), rgba(10, 13, 10, .78)); transition: background .9s ease; }
  .tuile span { font: 300 clamp(1.9rem, 4vw, 2.8rem)/1.15 var(--serif); color: var(--encre); padding: 0 20px; text-shadow: 0 2px 18px rgba(0, 0, 0, .6); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 10px; text-decoration-thickness: 1px; transition: text-decoration-color .4s ease; }
  .tuile.vue img, .tuile:focus-visible img { opacity: .95; transform: scale(1); filter: saturate(1); }
  .tuile.vue::after, .tuile:focus-visible::after { background: radial-gradient(ellipse at center, rgba(10, 13, 10, .35), rgba(10, 13, 10, .62)); }
  .tuile:focus-visible span { text-decoration-color: var(--or); }
  /* Ordinateur (retour de Gwen, 2026-10-27) : les photos sont claires d'emblée, comme sur téléphone quand la tuile est
     au milieu de l'écran ; le survol ajoute un léger zoom, un peu plus de lumière et le soulignement doré. */
  @media (hover: hover) and (pointer: fine) {
    .tuile img { opacity: .95; transform: scale(1); filter: saturate(1); }
    .tuile::after { background: radial-gradient(ellipse at center, rgba(10, 13, 10, .35), rgba(10, 13, 10, .62)); }
    .tuile:hover img { opacity: 1; transform: scale(1.04); filter: saturate(1.08) brightness(1.06); }
    .tuile:hover::after { background: radial-gradient(ellipse at center, rgba(10, 13, 10, .22), rgba(10, 13, 10, .5)); }
    .tuile:hover span { text-decoration-color: var(--or); }
  }
  /* Ordinateur (décision du 2026-10-27) : les tuiles côte à côte, en format vertical, comme des portes de salles.
     Toutes visibles sans défiler. Le téléphone garde les bandeaux empilés. */
  @media (min-width: 900px) {
    .choix { width: min(100%, 1180px); flex-direction: row; gap: clamp(18px, 2vw, 32px); }
    .choix li { flex: 1 1 0; min-width: 0; }
    .tuile { height: auto; aspect-ratio: 3 / 4; max-height: max(320px, calc(100vh - 360px)); width: 100%; }
    .tuile span { font-size: clamp(1.6rem, 2.2vw, 2.2rem); text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .tuile img, .tuile::after { transition: none; } }
</style>
