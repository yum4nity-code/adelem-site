---
import type { CollectionEntry } from 'astro:content';
import { prix, dims } from '../data/site';

interface Props { oeuvre: CollectionEntry<'oeuvres'>; long?: boolean }
const { oeuvre, long = false } = Astro.props;
const d = oeuvre.data;
// L'année n'est montrée que pour les pièces vendues (archives) : sur une pièce à vendre, elle fait « invendu » et,
// pour du végétal, fait naître la question de l'âge de la matière. Elle reste sur le certificat et la facture.
const annee = d.statut === 'vendue' ? d.annee : null;
// Dans la galerie, une pièce disponible invite à entrer (« Découvrir la pièce ») : « Disponible » ressemblait à un lien
// sans en être un et ne disait pas qu'il y avait plus à voir (2026-11-01, Gwen).
const statut = d.statut === 'vendue' ? 'Collection privée' : d.statut === 'reservee' ? 'Réservée' : 'Découvrir la pièce';
const nbPhotos = d.photos.length;
---
<div class:list={['cartel', { long }]}>
  <p class="titre">{d.titre}{annee && <span>, {annee}</span>}</p>
  {d.matieres.length > 0 && <p>{d.matieres.join(', ')}</p>}
  {long && d.type === 'tableau' && (
    <p class="stabilise">Matières naturelles stabilisées : elles gardent forme et couleur sans arrosage ni entretien, à l’abri du soleil direct.</p>
  )}
  {d.cadre && <p>{d.cadre}</p>}
  {long && d.provenance && <p>{d.provenance}</p>}
  <p>{dims(d.largeur_cm, d.hauteur_cm, long ? d.profondeur_cm : null)}{!long && d.statut === 'disponible' && <> · {prix(d.prix)}</>}</p>
  {!long && nbPhotos > 1 && <p class="nb-photos">{nbPhotos} photos</p>}
  {!long && <p class:list={['statut', { dispo: d.statut === 'disponible' }]}>{statut}{d.statut === 'disponible' && <span class="fleche" aria-hidden="true">→</span>}</p>}
</div>

<style>
  .cartel { font-size: .75rem; line-height: 1.6; color: var(--texte); display: flex; flex-direction: column; gap: 1px; }
  .titre { font: italic 400 1.2rem/1.3 var(--serif); color: var(--encre); margin-bottom: 3px; }
  .long { font-size: .92rem; gap: 3px; }
  .long .titre { display: none; }
  .stabilise { font-style: italic; color: var(--discret); margin: 2px 0; }
  .statut { margin-top: 5px; font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: var(--discret); }
  .statut.dispo { color: var(--or); }
  .fleche { display: inline-block; margin-left: .5em; transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
  .nb-photos { color: var(--discret); font-size: .7rem; }
</style>
