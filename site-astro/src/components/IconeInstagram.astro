---
// Pictogramme Instagram au trait, monochrome (couleur du texte) : discret, dans le ton du site.
interface Props { taille?: number }
const { taille = 18 } = Astro.props;
---
<svg width={taille} height={taille} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="display:block;flex-shrink:0">
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"></circle>
</svg>
