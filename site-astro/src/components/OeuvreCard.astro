---
import type { CollectionEntry } from 'astro:content';
import { prix } from '../data/site';

interface Props { oeuvre: CollectionEntry<'oeuvres'> }
const { oeuvre } = Astro.props;
const d = oeuvre.data;
const photo = d.photos[0];
const statut = { disponible: 'Disponible', reservee: 'Réservée', vendue: 'Collection privée' }[d.statut];
---
<article class="card">
  <a href={`/oeuvres/${oeuvre.id}`}>
    <img src={`/oeuvres/${oeuvre.id}/${photo.fichier}`} alt={photo.alt} loading="lazy" decoding="async" width="800" height="1000" />
    <div class="meta">
      <span class={d.statut === 'disponible' ? 'badge ok' : 'badge'}>{statut}</span>
      <h3>{d.titre}</h3>
      <p>{d.format}{d.dimensions_cm && ` · ${d.dimensions_cm.l} × ${d.dimensions_cm.h} cm`}</p>
      {d.statut !== 'vendue' && <p class="price">{prix(d.prix)}</p>}
    </div>
  </a>
</article>

<style>
  .card a { text-decoration: none; display: block; }
  .card img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; background: var(--soft); }
  .meta { padding-top: 1rem; }
  .meta h3 { margin: .6rem 0 .2rem; }
  .meta p { margin: 0; color: var(--muted); font-size: .92rem; }
  .meta .price { color: var(--ink); margin-top: .3rem; }
  .card a:hover h3 { color: var(--copper); }
</style>
