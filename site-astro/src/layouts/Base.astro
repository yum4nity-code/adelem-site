---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site, nav, indexable } from '../data/site';
import Analytics from '@vercel/analytics/astro';
import IconeInstagram from '../components/IconeInstagram.astro';
import Nouvelles from '../components/Nouvelles.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>;
  // Accueil : l'en-tête se pose, transparent, sur la photo d'ouverture, et sa signature s'efface
  // (celle de l'ouverture suffit : jamais deux signatures à l'écran).
  accueil?: boolean;
}
const { title, description = site.description, image, noindex = false, jsonld, accueil = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const fullTitle = title === site.nom ? `${site.nom}, tableaux végétaux et sculptures` : `${title}, ${site.nom}`;
// Image d'aperçu lors d'un partage (WhatsApp, Facebook, SMS…) : celle de la page, sinon l'image Adelem par défaut.
const ogImage = new URL(image ?? '/partage.jpg', site.url).href;
const current = Astro.url.pathname.replace(/\/$/, '');
const demo = (await getCollection('oeuvres')).some((o) => o.data.demo);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nom,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.instagram ? { sameAs: [site.contact.instagram] } : {}),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    {!image && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta property="og:image:alt" content={image ? title : 'Adelem : un tableau végétal accroché sous la signature Adelem'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1B211B" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {accueil && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.nom, url: site.url + '/' })} />}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <Analytics />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    {demo && <p class="bandeau-demo">Version test</p>}
    <header class:list={['entete', { 'sur-ouverture': accueil }]}>
      <div class="wrap barre">
        <a href="/" class="marque" aria-label="Adelem, accueil">
          <img src="/logo/adelem-signature.svg" alt="Adelem" width="150" height="62" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-principale">Menu</button>
        <nav id="nav-principale" class="menu" aria-label="Navigation principale">
          <ul>
            {nav.map((l, i) => (
              <li style={`--i:${i}`}><a href={l.href} aria-current={current === l.href || current.startsWith(l.href + '/') ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer class="pied">
      <!-- Bas de page (décision du 2026-10-27) : repères de confiance, navigation complète, inscription aux nouvelles pièces. -->
      <ul class="wrap confiance" aria-label="Nos engagements">
        <li>Pièce unique</li>
        <li>Fait main en France</li>
        <li>Emballage sur mesure</li>
      </ul>
      <!-- Bas de page épuré (2026-10-30, Gwen) : deux blocs (signature, nouvelles pièces) et une seule ligne de liens. -->
      <div class="wrap pied-grille">
        <div class="pied-marque">
          <a href="/" aria-label="Adelem, accueil"><img src="/logo/adelem-signature.svg" alt="Adelem" width="130" height="54" loading="lazy" /></a>
          <p>Végétaux stabilisés, sculptures et fleurs en porcelaine froide.</p>
        </div>
        <div class="pied-nouvelles"><Nouvelles /></div>
      </div>
      <nav class="wrap pied-bas" aria-label="Informations">
        <ul>
          {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
          {site.contact.instagram && <li><a class="insta" href={site.contact.instagram}><IconeInstagram /> Instagram</a></li>}
          <li><a href="/livraison">Livraison</a></li>
          <li><a href="/cgv">Conditions de vente</a></li>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li>© {new Date().getFullYear()} Adelem</li>
        </ul>
      </nav>
    </footer>
    <script>
      const b = document.querySelector('.menu-btn');
      const n = document.getElementById('nav-principale');
      // Le bouton devient « Fermer » quand le rideau du menu est ouvert (téléphone).
      const libelle = (o: boolean) => { if (b) b.textContent = o ? 'Fermer' : 'Menu'; };
      b?.addEventListener('click', () => {
        const o = !!n?.classList.toggle('ouvert');
        b.setAttribute('aria-expanded', String(o));
        libelle(o);
      });
      // Fermer le menu : au choix d'un lien, au toucher hors du menu, et au retour arrière (le navigateur
      // restaure la page telle qu'on l'a quittée, menu ouvert compris).
      const fermer = () => { n?.classList.remove('ouvert'); b?.setAttribute('aria-expanded', 'false'); libelle(false); };
      n?.querySelectorAll('a').forEach((a) => a.addEventListener('click', fermer));
      document.addEventListener('click', (e) => {
        if (n?.classList.contains('ouvert') && !n.contains(e.target as Node) && !b?.contains(e.target as Node)) fermer();
      });
      addEventListener('pageshow', fermer);
      n?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && n.classList.contains('ouvert')) {
          fermer();
          b?.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  /* Mention discrète tant que le site montre des œuvres d'exemple : posée en haut au centre, hors du flux. */
  .bandeau-demo { position: absolute; top: 6px; left: 50%; transform: translateX(-50%); z-index: 11; margin: 0; font: 500 .58rem/1 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--discret); pointer-events: none; white-space: nowrap; }
  .entete { position: relative; z-index: 10; }
  .sur-ouverture { margin-bottom: -72px; }
  .sur-ouverture .marque { opacity: 0; transition: opacity .3s ease; }
  .sur-ouverture .marque:focus-visible { opacity: 1; }
  .barre { display: flex; align-items: center; justify-content: space-between; min-height: 72px; }
  .marque img { width: 150px; height: auto; filter: invert(.92); }
  /* Menu (décision du 2026-10-26, demande d'Adèle) : les mots écrits comme ils s'écrivent (« Galerie », « À propos »),
     dans la même police sur téléphone et sur ordinateur, au lieu de petites capitales espacées sur ordinateur. */
  .menu-btn { background: none; border: 0; cursor: pointer; font: 400 1.15rem var(--serif); letter-spacing: .01em; min-height: 44px; padding: 0; color: var(--encre); }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  /* Fil d'or (2026-10-30, Gwen) : au survol, un trait doré se trace sous le mot, de gauche à droite, comme une signature.
     La page en cours garde un trait clair, déjà tracé. */
  .menu a { position: relative; display: inline-block; color: var(--encre); }
  .menu a::after { content: ''; position: absolute; left: 0; right: 0; bottom: var(--fil-bas, -6px); height: 1px; background: var(--or); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.65, 0, .35, 1); }
  .menu a[aria-current='page']::after { transform: scaleX(1); background: var(--encre); }
  .menu a:focus-visible::after { transform: scaleX(1); }
  @media (hover: hover) { .menu a:hover::after { transform: scaleX(1); background: var(--or); } }
  /* Téléphone : menu « rideau » (2026-10-30, Gwen). L'écran se couvre de vert sombre de haut en bas, puis les mots
     montent un par un, comme un rideau qui s'ouvre sur la salle. Avec « réduire les animations », il s'ouvre sans effet. */
  @media (max-width: 819.98px) {
    .marque, .menu-btn { position: relative; z-index: 2; }
    .entete:has(.menu.ouvert) .marque { opacity: 1; }
    :global(html:has(.menu.ouvert)) { overflow: hidden; }
    .menu {
      position: fixed; inset: 0; z-index: 1; background: var(--mur); padding: 120px var(--gutter) 40px; overflow-y: auto;
      clip-path: inset(0 0 100% 0); visibility: hidden;
      transition: clip-path .5s cubic-bezier(.65, 0, .35, 1), visibility 0s linear .5s;
    }
    .menu.ouvert { clip-path: inset(0); visibility: visible; transition: clip-path .55s cubic-bezier(.65, 0, .35, 1), visibility 0s; }
    .menu ul { display: grid; gap: 6px; border-top: 1px solid var(--trait); padding-top: 22px; }
    .menu li { opacity: 0; transform: translateY(18px); transition: opacity .25s ease, transform .25s ease; }
    .menu.ouvert li { opacity: 1; transform: none; transition: opacity .5s ease, transform .7s cubic-bezier(.16, 1, .3, 1); transition-delay: calc(.2s + var(--i) * .08s); }
    .menu a { font: 300 2.4rem/1.2 var(--serif); padding: 8px 0; --fil-bas: 6px; }
  }
  @media (min-width: 820px) {
    .menu-btn { display: none; }
    .menu ul { display: flex; gap: 36px; }
    .menu a { font: 400 1.15rem var(--serif); letter-spacing: .01em; padding: 0; }
  }
  .pied { margin-top: clamp(64px, 8vw, 120px); border-top: 1px solid var(--trait); padding-block: 0 28px; font-size: .86rem; color: var(--discret); }
  .confiance { list-style: none; margin: 0 auto; padding: 22px 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 0; border-bottom: 1px solid var(--trait); font: italic 300 1.05rem var(--serif); color: var(--texte); }
  .confiance li { padding: 0 18px; }
  .confiance li + li { border-left: 1px solid var(--trait); }
  .pied-grille { display: grid; gap: 32px 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); padding-top: 48px; align-items: start; }
  .pied-marque { display: flex; flex-direction: column; gap: 10px; }
  .pied-marque img { width: 130px; height: auto; filter: invert(.92); opacity: .9; }
  .pied-marque p { margin: 0; max-width: 30ch; }
  .pied-nouvelles { justify-self: end; width: min(100%, 420px); }
  .pied a:hover { color: var(--encre); }
  .pied-bas { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--trait); font-size: .78rem; }
  .pied-bas ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 0; }
  .pied-bas li { display: inline-flex; align-items: center; }
  .pied-bas li + li::before { content: '·'; margin: 0 12px; color: var(--discret); }
  .pied-bas a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; color: var(--texte); }
  .pied-bas .insta :global(svg) { width: 14px; height: 14px; }
  .pied-bas a { background: linear-gradient(var(--or), var(--or)) no-repeat left calc(100% - 4px) / 0 1px; transition: background-size .45s cubic-bezier(.65, 0, .35, 1), color .3s; }
  @media (hover: hover) { .pied-bas a:hover { background-size: 100% 1px; } }
  /* Téléphone : inscription en premier, signature en petit, liens sur quelques lignes. */
  @media (max-width: 600px) {
    .confiance { font-size: .9rem; padding: 14px 0; } .confiance li { padding: 0 9px; }
    .pied-grille { display: flex; flex-direction: column; gap: 18px; padding-top: 26px; }
    .pied-nouvelles { order: -1; justify-self: stretch; width: 100%; }
    .pied-marque { flex-direction: row; align-items: center; gap: 14px; }
    .pied-marque img { width: 92px; }
    .pied-marque p { display: none; }
    .pied-bas { margin-top: 18px; padding-top: 14px; }
    .pied-bas ul { gap: 0 20px; }
    .pied-bas li + li::before { display: none; }
  }
</style>
