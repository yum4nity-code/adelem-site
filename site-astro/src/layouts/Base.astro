---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site, nav, indexable } from '../data/site';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>;
}
const { title, description = site.description, image, noindex = false, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const fullTitle = title === site.nom ? `${site.nom}, tableaux végétaux et sculptures` : `${title}, ${site.nom}`;
const ogImage = image ? new URL(image, site.url).href : null;
const current = Astro.url.pathname.replace(/\/$/, '');
const demo = (await getCollection('oeuvres')).some((o) => o.data.demo);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nom,
  url: site.url,
  logo: new URL('/logo/adelem-badge-transparent.svg', site.url).href,
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.instagram ? { sameAs: [site.contact.instagram] } : {}),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#1B211B" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <Analytics />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    {demo && <p class="bandeau-demo">Version de travail : œuvres, photos et prix d’exemple.</p>}
    <header class="entete">
      <div class="wrap barre">
        <a href="/" class="marque" aria-label="Adelem, accueil">
          <img src="/logo/adelem-signature.svg" alt="Adelem" width="150" height="62" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-principale">Menu</button>
        <nav id="nav-principale" class="menu" aria-label="Navigation principale">
          <ul>
            {nav.map((l) => (
              <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer class="pied">
      <div class="wrap pied-grille">
        <p>Adelem</p>
        <ul>
          {site.contact.instagram && <li><a href={site.contact.instagram}>Instagram</a></li>}
          <li><a href="/livraison">Emballage et livraison</a></li>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/cgv">Conditions de vente</a></li>
        </ul>
      </div>
    </footer>
    <script>
      const b = document.querySelector('.menu-btn');
      const n = document.getElementById('nav-principale');
      b?.addEventListener('click', () => {
        const o = n?.classList.toggle('ouvert');
        b.setAttribute('aria-expanded', String(!!o));
      });
      n?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && n.classList.contains('ouvert')) {
          n.classList.remove('ouvert');
          b?.setAttribute('aria-expanded', 'false');
          b?.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  .bandeau-demo { background: #efe3b8; color: #1F221E; text-align: center; font-size: .78rem; padding: 6px 12px; letter-spacing: .02em; }
  .entete { position: relative; z-index: 10; }
  .barre { display: flex; align-items: center; justify-content: space-between; min-height: 72px; }
  .marque img { width: 150px; height: auto; filter: invert(.92); }
  .menu-btn { background: none; border: 0; cursor: pointer; font: 500 .72rem var(--sans); letter-spacing: .16em; text-transform: uppercase; min-height: 44px; padding: 0; color: var(--encre); }
  .menu { display: none; position: absolute; right: var(--gutter); left: var(--gutter); top: 64px; background: var(--mur); border: 1px solid var(--trait); padding: 12px 20px; }
  .menu.ouvert { display: block; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { display: block; padding: 10px 0; font: 300 1.4rem var(--serif); color: var(--encre); }
  @media (min-width: 820px) {
    .menu-btn { display: none; }
    .menu { display: block; position: static; border: 0; padding: 0; background: none !important; }
    .menu ul { display: flex; gap: 36px; }
    .menu a { font: 400 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; padding: 0; }
    .menu a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  }
  .pied { margin-top: clamp(96px, 12vw, 180px); border-top: 1px solid var(--trait); padding-block: 32px; font-size: .78rem; color: var(--discret); letter-spacing: .03em; }
  .pied-grille { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; }
  .pied ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .pied a:hover { color: var(--encre); }
</style>
