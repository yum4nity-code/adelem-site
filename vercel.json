{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd site-astro && npm ci",
  "buildCommand": "cd site-astro && npm run build",
  "outputDirectory": "site-astro/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sur-mesure",
      "destination": "/galerie",
      "permanent": false
    },
    {
      "source": "/herbier",
      "destination": "/a-propos",
      "permanent": false
    },
    {
      "source": "/herbier/:chemin*",
      "destination": "/a-propos",
      "permanent": false
    }
  ]
}
